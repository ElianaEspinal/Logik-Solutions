---
// Zona para adjuntar facturas (arrastrar o tocar), varias a la vez. La comparten el formulario de
// contacto, el de cierre (ContactForm) y el pre-estudi. PDF o foto (JPG, PNG, WEBP): máximo 5
// archivos, 20 MB cada uno y 20 MB en total (los mismos límites que el servidor, docs/formulario.md).
// El comportamiento (lista, quitar, arrastrar, errores) está en src/scripts/file-drop.ts.
import type { Locale } from '../config/pages';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Locale;
  /** Prefijo de los id, único en la página. */
  idPrefix: string;
  /** Textos propios (p. ej. la página de contacto); por defecto, los de src/i18n/ui.ts. */
  label?: string;
  privacy?: string;
}

const { lang, idPrefix, label, privacy } = Astro.props;
const t = useTranslations(lang);
const id = (name: string) => `${idPrefix}-${name}`;
---

<div class="field drop" data-drop data-remove-label={t('form.attachRemove')}>
  <input
    class="drop__input"
    id={id('file')}
    name="factura[]"
    type="file"
    multiple
    accept=".pdf,.jpg,.jpeg,.png,.webp"
    aria-describedby={`${id('file-hint')} ${id('file-error')} ${id('file-privacy')}`}
  />
  <label class="drop__zone" for={id('file')}>
    <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"></path>
      <path d="M14 3v5h5M12 18v-6M9 15l3-3 3 3"></path>
    </svg>
    <strong>{label ?? t('form.attach')}</strong>
    <span>{t('form.attachDrop')}</span>
    <span class="drop__hint" id={id('file-hint')}>{t('form.attachHint')}</span>
  </label>
  <ul class="drop__files" data-drop-files hidden></ul>
  <p class="field__error" id={id('file-error')} data-error-for="factura" aria-live="polite" hidden></p>
  <p class="drop__privacy" id={id('file-privacy')}>{privacy ?? t('form.attachPrivacy')}</p>
</div>

<style>
  .drop {
    position: relative;
    margin: 0;
  }

  .drop__input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .drop__zone {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 1.25rem 1rem;
    border: 2px dashed var(--teal-100);
    border-radius: 1rem;
    background: var(--cream);
    color: var(--teal-900);
    font-weight: 400;
    text-align: center;
    cursor: pointer;
    transition:
      border-color 0.15s,
      background-color 0.15s;
  }

  .drop__zone svg {
    color: var(--orange-700);
  }

  .drop__hint {
    color: var(--text-muted);
  }

  .drop:global(.is-over) .drop__zone,
  .drop__input:focus-visible + .drop__zone {
    border-color: var(--orange-700);
    background: var(--orange-100);
  }

  .drop__input:focus-visible + .drop__zone {
    outline: 3px solid var(--orange-500);
    outline-offset: 2px;
  }

  /* Con archivos, la zona se queda más compacta para añadir otro; con 5, desaparece. */
  .drop:global(.has-file) .drop__zone {
    padding: 0.75rem 1rem;
  }

  .drop:global(.is-full) .drop__zone {
    display: none;
  }

  .drop__files {
    display: grid;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .drop__files[hidden] {
    display: none;
  }

  .drop__files :global(.drop__file) {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.5rem 0.5rem 0.875rem;
    border: 1.5px solid var(--teal-900);
    border-radius: 0.75rem;
    background: var(--white);
  }

  .drop__files :global(.drop__name) {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
    font-weight: 700;
  }

  .drop__files :global(.drop__remove) {
    flex: none;
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.875rem;
    border: 1px solid var(--teal-100);
    border-radius: 999px;
    background: var(--white);
    color: var(--teal-900);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .drop__privacy {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
  }
</style>
