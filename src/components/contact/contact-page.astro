---
// Página de contacto (/contacte/ y /es/contacto/). Un único objetivo: enviar el formulario o llamar.
// Móvil (desde 360 px): título → Truca / WhatsApp → formulario → datos → "Què passa després" → mapa.
// Escritorio (>= 64rem): datos a la izquierda (≈ 40 %), formulario a la derecha (≈ 60 %); mapa a todo el ancho.
// Todos los datos del negocio salen de src/config/site.ts (coherencia NAP).
import ContactForm from './contact-form.astro';
import { directionsUrl, hasHours, hoursLabel, mapEmbedUrl, phone, site } from '../../config/site';
import type { Locale } from '../../config/pages';
import type { ContactContent } from './types';
import '../../styles/motion.css';

interface Props {
  lang: Locale;
  content: ContactContent;
}

const { lang, content: c } = Astro.props;

const icon = {
  phone:
    '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"/>',
  whatsapp: '<path d="M3 21l1.7-5A8.5 8.5 0 1 1 8 19.4Z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 1a4 4 0 0 1-2-2l1-1-1-2Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  pin: '<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  car: '<path d="M4 16v-4l2-5h12l2 5v4M4 16h16M4 16v2M20 16v2"/><circle cx="7.5" cy="13" r="0.5"/><circle cx="16.5" cy="13" r="0.5"/>',
  review: '<path d="M6 2h9l4 4v16H5V2Z"/><circle cx="11" cy="13" r="3"/><path d="m13.2 15.2 2.3 2.3"/>',
  talk: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 21l1.9-5.4A8 8 0 1 1 21 12Z"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01"/>',
  study: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/><path d="m14 6 3-2 3 2"/>',
};
const nextIcons = [icon.review, icon.talk, icon.study];

type Row = { key: string; icon: string; label: string; value: string; href?: string; attrs?: Record<string, string>; extra?: string };
const rows: Row[] = [
  { key: 'phone', icon: icon.phone, label: c.panel.phone, value: phone.display, href: phone.tel },
  {
    key: 'whatsapp',
    icon: icon.whatsapp,
    label: c.panel.whatsapp,
    value: c.panel.whatsappValue,
    href: phone.whatsapp,
    attrs: { target: '_blank', rel: 'noopener' },
  },
  { key: 'email', icon: icon.mail, label: c.panel.email, value: site.email, href: `mailto:${site.email}` },
  {
    key: 'address',
    icon: icon.pin,
    label: c.panel.address,
    // Solo código postal y localidad en el panel (decisión de Eliana, 3/11/2026).
    value: [site.address.postalCode, site.address.locality].filter(Boolean).join(' '),
    href: directionsUrl,
    attrs: { target: '_blank', rel: 'noopener', 'data-directions': '' },
    extra: c.panel.directions,
  },
  ...(hasHours ? [{ key: 'hours', icon: icon.clock, label: c.panel.hours, value: hoursLabel[lang] }] : []),
];
---

<div class="cp" data-section="contacte">
  <!-- Cabecera de la página -->
  <section class="cp-hero surface-grid" aria-labelledby="cp-title">
    <div class="container cp-hero__inner">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1 id="cp-title">{c.title}</h1>
      <p class="cp-hero__lead">{c.lead}</p>
      <!-- Acción rápida en móvil y tablet (en escritorio están en el panel de datos). -->
      <div class="cp-quick">
        <a class="btn btn-secondary btn-lg" href={phone.tel} data-cta="contacte_hero">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon.phone} />
          <span>{c.quick.call}<span class="sr-only"> {phone.display}</span></span>
        </a>
        <a class="btn btn-primary btn-lg" href={phone.whatsapp} target="_blank" rel="noopener noreferrer" data-cta="contacte_hero">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon.whatsapp} />
          <span>{c.quick.whatsapp}<span class="sr-only"> {phone.display}</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Formulario + datos de contacto -->
  <section class="cp-main" aria-label={c.eyebrow}>
    <div class="container cp-grid">
      <div class="cp-card">
        <ContactForm lang={lang} c={c.form} />
      </div>

      <aside class="cp-panel tech-bg" aria-labelledby="cp-panel-title" data-reveal>
        <h2 id="cp-panel-title" class="cp-panel__title">{c.panel.title}</h2>
        <ul class="cp-rows">
          {
            rows.map((row, i) => {
              const inner = (
                <>
                  <span class="cp-row__icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={row.icon} />
                  </span>
                  <span class="cp-row__text">
                    <span class="cp-row__label">{row.label}</span>
                    <span class="cp-row__value">{row.value}</span>
                    {row.extra && (
                      <span class="cp-row__extra">
                        {row.extra} <span aria-hidden="true">→</span>
                      </span>
                    )}
                  </span>
                </>
              );
              return (
                <li class="cp-row" style={`--i:${i}`} data-row={row.key}>
                  {row.href ? (
                    <a class="cp-row__link" href={row.href} {...row.attrs}>
                      {inner}
                    </a>
                  ) : (
                    <div class="cp-row__link cp-row__link--static">{inner}</div>
                  )}
                </li>
              );
            })
          }
        </ul>
        <p class="cp-panel__visits" style={`--i:${rows.length}`}>
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon.car} />
          {c.panel.visits}
        </p>
      </aside>
    </div>
  </section>

  <!-- Què passa després? -->
  <section class="section cp-next band-alt" aria-labelledby="cp-next-title">
    <div class="container">
      <h2 id="cp-next-title" class="cp-next__title" data-reveal>{c.next.title}</h2>
      <ol class="cp-next__list">
        {
          c.next.steps.map((step, i) => (
            <li class="cp-next__item card" data-reveal style={`--i:${i}`}>
              <span class="cp-next__icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={nextIcons[i]} />
              </span>
              <span class="cp-next__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{step}</h3>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- On som: el mapa de Google solo se carga con el consentimiento de contingut extern. -->
  <section class="section cp-map" aria-labelledby="cp-map-title">
    <div class="container">
      <div class="cp-map__card card" data-reveal>
        <div class="cp-map__info">
          <h2 id="cp-map-title">{c.map.title}</h2>
          <p class="cp-map__address"><strong>{site.name}</strong></p>
          <a class="btn btn-secondary" href={directionsUrl} target="_blank" rel="noopener noreferrer" data-directions>
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon.pin} />
            {c.map.directions}
          </a>
        </div>
        <div class="cp-map__frame consent-embed" data-consent-embed data-src={mapEmbedUrl} data-title={c.map.frameTitle}>
          <div class="cp-map__placeholder" data-embed-placeholder>
            <span class="cp-map__pin" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon.pin} />
            </span>
            <p>{c.map.note}</p>
            <!-- Sin JS no se puede cargar el mapa: el botón solo aparece con JS. -->
            <button class="btn btn-primary cp-map__load" type="button" data-embed-load>{c.map.load}</button>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  import { initReveal } from '../../scripts/motion';

  initReveal();
</script>

<style>
  /* ---- Cabecera de la página ---- */
  .cp-hero {
    padding-block: 1.5rem 1.75rem;
  }

  .cp-hero h1 {
    max-width: 22ch;
    margin-bottom: 0.75rem;
    font-size: clamp(1.75rem, 4.5vw + 0.75rem, 3.25rem);
  }

  .cp-hero__lead {
    max-width: 40rem;
    margin-bottom: 1.25rem;
    color: var(--text-muted);
    font-size: 1.125rem;
  }

  .cp-quick {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.625rem;
  }

  .cp-quick .btn {
    min-width: 0;
    padding-inline: 0.75rem;
  }

  @media (min-width: 48rem) {
    .cp-hero {
      padding-block: 3rem 2.5rem;
    }

    .cp-quick {
      max-width: 28rem;
    }
  }

  @media (min-width: 64rem) {
    .cp-hero {
      padding-block: 3.5rem 2.5rem;
    }

    .cp-hero__lead {
      margin-bottom: 0;
      font-size: 1.25rem;
    }

    .cp-quick {
      display: none;
    }
  }

  /* ---- Formulario + datos ---- */
  .cp-main {
    padding-block: 0.5rem 3rem;
  }

  .cp-grid {
    display: grid;
    gap: 1.5rem;
  }

  .cp-card {
    position: relative;
    min-width: 0;
    padding: 1.25rem 1rem 1.5rem;
    border: 1px solid var(--teal-100);
    border-radius: 1.5rem;
    background: var(--white);
    box-shadow:
      0 1.5rem 3rem -1.75rem color-mix(in srgb, var(--teal-900) 45%, transparent),
      0 0 0 4px color-mix(in srgb, var(--orange-500) 6%, transparent);
  }

  /* Borde luminoso muy sutil en la parte superior. */
  .cp-card::before {
    content: '';
    position: absolute;
    inset: -1px 12% auto;
    height: 3px;
    border-radius: 0 0 3px 3px;
    background: linear-gradient(90deg, transparent, var(--orange-500), transparent);
  }

  @media (min-width: 22.5rem) {
    .cp-card {
      padding-inline: 1.25rem;
    }
  }

  @media (min-width: 48rem) {
    .cp-card {
      padding: 2rem;
    }
  }

  @media (min-width: 64rem) {
    .cp-main {
      padding-bottom: 5rem;
    }

    .cp-grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: start;
      gap: 2rem;
    }

    .cp-panel {
      grid-column: 1;
      grid-row: 1;
      position: sticky;
      top: calc(var(--header-h, 64px) + 1.5rem);
    }

    .cp-card {
      grid-column: 2;
      grid-row: 1;
      padding: 2.25rem 2.5rem 2.5rem;
    }
  }

  /* ---- Panel de datos (teal con degradado y cuadrícula: .tech-bg) ---- */
  .cp-panel {
    padding: 1.75rem 1.25rem;
    border-radius: 1.5rem;
    color: var(--white);
  }

  .cp-panel__title {
    margin-bottom: 1.25rem;
    color: var(--white);
    font-size: clamp(1.5rem, 2vw + 1rem, 2rem);
  }

  .cp-rows {
    display: grid;
    gap: 0.25rem;
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
  }

  .cp-row__link {
    display: flex;
    gap: 0.875rem;
    align-items: center;
    min-height: 44px;
    padding: 0.75rem 0.5rem;
    margin-inline: -0.5rem;
    border-radius: 1rem;
    color: var(--white);
    text-decoration: none;
    transition: background-color 0.2s;
  }

  a.cp-row__link:is(:hover, :focus-visible, :active) {
    background: color-mix(in srgb, var(--white) 7%, transparent);
  }

  .cp-row__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid color-mix(in srgb, var(--white) 18%, transparent);
    border-radius: 0.875rem;
    background: color-mix(in srgb, var(--white) 6%, transparent);
    color: var(--orange-500);
    transition: transform 0.2s ease;
  }

  a.cp-row__link:is(:hover, :focus-visible) .cp-row__icon {
    transform: scale(1.06);
  }

  .cp-row__text {
    display: grid;
    min-width: 0;
  }

  .cp-row__label {
    color: var(--teal-100);
    font-size: 1rem;
    line-height: 1.3;
  }

  .cp-row__value {
    overflow-wrap: anywhere;
    font-family: var(--font-heading);
    font-size: clamp(1.125rem, 1vw + 0.9rem, 1.375rem);
    font-weight: 700;
    line-height: 1.3;
  }

  /* Sin subrayado; subrayado animado en el valor al pasar el cursor, enfocar o tocar. */
  a.cp-row__link .cp-row__value {
    width: fit-content;
    max-width: 100%;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
    transition:
      text-decoration-color 0.2s ease,
      text-underline-offset 0.2s ease;
  }

  a.cp-row__link:is(:hover, :focus-visible, :active) .cp-row__value {
    text-decoration-color: var(--orange-500);
    text-underline-offset: 0.2em;
  }

  .cp-row__extra {
    margin-top: 0.125rem;
    color: var(--orange-100);
    font-weight: 700;
  }

  .cp-row__extra span {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  a.cp-row__link:is(:hover, :focus-visible, :active) .cp-row__extra span {
    transform: translateX(4px);
  }

  .cp-panel__visits {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--white) 16%, transparent);
    color: var(--teal-100);
  }

  .cp-panel__visits svg {
    flex: none;
    margin-top: 0.125rem;
    color: var(--orange-500);
  }

  @media (min-width: 48rem) {
    .cp-panel {
      padding: 2rem;
    }
  }

  /* Filas con retardo escalonado: en escritorio al cargar (el panel está en el primer pantallazo);
     en móvil, cuando el panel entra en pantalla (.is-revealed de src/scripts/motion.ts). */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .cp-panel:global(.is-revealed) :is(.cp-row, .cp-panel__visits) {
      animation: cp-row-in 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(var(--i, 0) * 80ms + 120ms);
    }
  }

  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    .cp-row,
    .cp-panel__visits {
      animation: cp-row-in 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(var(--i, 0) * 80ms + 150ms);
    }
  }

  @keyframes cp-row-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* ---- Què passa després ---- */
  .cp-next__title {
    margin-bottom: 1.5rem;
  }

  .cp-next__list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .cp-next__item {
    position: relative;
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1rem 3rem 1rem 1.25rem; /* hueco a la derecha para el número */
  }

  .cp-next__item h3 {
    margin: 0;
    font-size: 1.125rem;
  }

  .cp-next__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.875rem;
    background: var(--teal-900);
    color: var(--orange-500);
  }

  .cp-next__num {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    color: var(--text-muted);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  @media (min-width: 48rem) {
    .cp-next__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }

    .cp-next__item {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem;
    }
  }

  /* ---- Mapa ---- */
  .cp-map__card {
    display: grid;
    overflow: hidden;
    border-radius: 1.5rem;
  }

  .cp-map__info {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding: 1.5rem 1.25rem;
  }

  .cp-map__info h2 {
    margin: 0;
  }

  .cp-map__address {
    display: grid;
    font-style: normal;
    font-size: 1.125rem;
  }

  /* Altura reservada desde el principio: el mapa no mueve nada al cargarse (sin CLS). */
  .cp-map__frame {
    min-height: 18rem;
    aspect-ratio: 4 / 3;
    border-radius: 0;
    background:
      linear-gradient(color-mix(in srgb, var(--white) 8%, transparent) 1px, transparent 1px) 0 0 / 2rem 2rem,
      linear-gradient(90deg, color-mix(in srgb, var(--white) 8%, transparent) 1px, transparent 1px) 0 0 / 2rem 2rem,
      radial-gradient(30rem 20rem at 80% 20%, color-mix(in srgb, var(--orange-500) 18%, transparent), transparent 70%),
      var(--teal-900);
  }

  .cp-map__placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    height: 100%;
    padding: 1.5rem;
    color: var(--white);
    text-align: center;
    --focus-ring: var(--orange-100);
  }

  .cp-map__placeholder p {
    max-width: 26rem;
    margin: 0;
    color: var(--teal-100);
  }

  .cp-map__pin {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--orange-500) 18%, transparent);
    color: var(--orange-500);
    box-shadow: 0 0 0 8px color-mix(in srgb, var(--orange-500) 8%, transparent);
  }

  html:not(.js) .cp-map__load {
    display: none;
  }

  @media (min-width: 48rem) {
    .cp-map__card {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    }

    .cp-map__info {
      align-content: center;
      padding: 2.5rem;
    }

    .cp-map__frame {
      aspect-ratio: auto;
      min-height: 22rem;
    }
  }
</style>
