---
// Preguntas frecuentes en acordeón (<details>/<summary>: el texto está en el HTML).
// Escritorio: columna izquierda fija al hacer scroll (título, frase y tarjeta de contacto)
// y el acordeón a la derecha. Móvil: acordeón a todo el ancho y la tarjeta debajo.
// Las 10 respuestas coinciden palabra por palabra con el JSON-LD FAQPage (schema.ts).
// En la respuesta que menciona la política de privacidad, esas palabras enlazan a la página.
import { pages, type Locale } from '../../config/pages';
import { phone } from '../../config/site';
import { useTranslations } from '../../i18n/ui';
import type { HomeContent } from './types';

// Reutilizable (home y Nosaltres): eyebrow, intro y tarjeta lateral son opcionales.
type FaqContent = Pick<HomeContent['faq'], 'title' | 'items'> & Partial<Omit<HomeContent['faq'], 'title' | 'items'>>;

interface Props {
  lang: Locale;
  content: FaqContent;
  /** Prefijo de los id (único en la página) y nombre del grupo de <details> (acordeón exclusivo). */
  idPrefix?: string;
  /** data-section para la analítica. */
  section?: string;
}

const { lang, content: c, idPrefix = 'faq', section = 'faq' } = Astro.props;
const t = useTranslations(lang);
const privacy = t('form.consentLink');
const hasCard = !!(c.cardTitle && c.cardText);
const [cardBefore, cardAfter] = (c.cardText ?? '').split('{phone}');
---

<section class="section band-alt faq-section" aria-labelledby={`${idPrefix}-title`} data-section={section}>
  <div class:list={['container', 'faq-acc', { 'faq-acc--plain': !hasCard }]}>
    <!-- Lateral: fijo en escritorio; en móvil se "deshace" (display: contents) y la tarjeta
         pasa debajo del acordeón. -->
    <div class="faq-acc__side">
      <div class="faq-acc__head">
        {c.eyebrow && <p class="eyebrow" data-reveal>{c.eyebrow}</p>}
        <h2 id={`${idPrefix}-title`} data-reveal>{c.title}</h2>
        {c.intro && <p class="faq-acc__intro" data-reveal>{c.intro}</p>}
      </div>
      {hasCard && (
      <aside class="faq-acc__card" aria-labelledby={`${idPrefix}-card-title`}>
        <p class="faq-acc__card-title" id={`${idPrefix}-card-title`}>{c.cardTitle}</p>
        <p class="faq-acc__card-text">{cardBefore}{phone.display}{cardAfter}</p>
        <div class="faq-acc__card-actions">
          <a class="btn btn-primary" href={phone.whatsapp} rel="noopener">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.7-5A8.5 8.5 0 1 1 8 19.4Z"></path><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 1a4 4 0 0 1-2-2l1-1-1-2Z"></path></svg>
            {t('cta.whatsappLong')}
          </a>
          <a class="btn btn-ghost faq-acc__call" href={phone.tel}>
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"></path></svg>
            {t('cta.callAt')} {phone.display}
          </a>
        </div>
      </aside>
      )}
    </div>

    <div class="faq-acc__list">
      {
        c.items.map((item, i) => (
          <details class="faq-acc__item" name={idPrefix} open={i === 0} data-reveal data-faq style={`--i:${i % 3}`}>
            <summary>
              <h3>{item.q}</h3>
              <span class="faq-acc__chev" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
              </span>
            </summary>
            <div class="faq-acc__answer">
              <p>
                {item.a.includes(privacy)
                  ? item.a.split(privacy).map((part, j, all) => (
                      <>
                        {part}
                        {j < all.length - 1 && <a href={pages.privacitat[lang]}>{privacy}</a>}
                      </>
                    ))
                  : item.a}
              </p>
            </div>
          </details>
        ))
      }
    </div>

  </div>
</section>

<script>
  // Acordeón exclusivo: <details name="faq"> lo hace solo en los navegadores actuales; aquí,
  // el respaldo para los que no lo admiten. Además, al abrir una pregunta, la que se cierra
  // lo hace sin animación y se compensa el scroll: la pregunta tocada no se mueve de sitio.
  const items = [...document.querySelectorAll<HTMLDetailsElement>('[data-faq]')];
  const nativeExclusive = 'name' in HTMLDetailsElement.prototype;
  items.forEach((item) => {
    const summary = item.querySelector('summary')!;
    summary.addEventListener('click', () => {
      if (item.open) return; // se está cerrando: nada que compensar
      const before = summary.getBoundingClientRect().top;
      items.forEach((other) => {
        // Solo el mismo grupo: dos FAQ en una página no se cierran entre sí.
        if (other === item || !other.open || other.name !== item.name) return;
        other.classList.add('is-instant');
        if (!nativeExclusive) other.open = false;
      });
      requestAnimationFrame(() => {
        const delta = summary.getBoundingClientRect().top - before;
        if (Math.abs(delta) > 1) window.scrollBy({ top: delta, behavior: 'instant' });
        items.forEach((other) => other.classList.remove('is-instant'));
      });
    });
  });
</script>

<style>
  .faq-acc {
    display: grid;
    gap: 1.5rem;
  }

  .faq-acc__intro {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.125rem;
  }

  .faq-acc__list {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
  }

  .faq-acc__item {
    border: 1px solid color-mix(in srgb, var(--teal-900) 10%, transparent);
    border-radius: 1rem;
    background: var(--white);
    transition:
      border-color 0.2s,
      box-shadow 0.25s;
  }

  .faq-acc__item[open] {
    border-color: color-mix(in srgb, var(--orange-500) 60%, transparent);
    box-shadow: 0 1rem 2rem -1.5rem color-mix(in srgb, var(--teal-900) 40%, transparent);
  }

  .faq-acc__item summary {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    padding: 0.875rem 1rem 0.875rem 1.25rem;
    border-radius: 1rem;
    cursor: pointer;
    list-style: none;
  }

  .faq-acc__item summary::-webkit-details-marker {
    display: none;
  }

  .faq-acc__item summary h3 {
    margin: 0;
    font-size: 1.125rem;
  }

  .faq-acc__chev {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--teal-100);
    color: var(--teal-900);
    transition:
      transform 0.25s ease,
      background-color 0.2s;
  }

  .faq-acc__item[open] .faq-acc__chev {
    background: var(--orange-500);
    transform: rotate(180deg);
  }

  @media (hover: hover) {
    .faq-acc__item summary:hover .faq-acc__chev {
      background: var(--orange-100);
    }
  }

  .faq-acc__answer {
    padding: 0 1.25rem 1.25rem;
  }

  .faq-acc__answer p {
    margin: 0;
    color: var(--text-muted);
  }

  /* El enlace del texto corrido: teal (el naranja oscuro no llega a 4,5 sobre el fondo de la banda). */
  .faq-acc__answer a {
    color: var(--teal-900);
    text-decoration-color: var(--orange-700);
  }

  /* Apertura suave de la altura donde el navegador lo admite (sin JS). */
  @supports (interpolate-size: allow-keywords) {
    @media (prefers-reduced-motion: no-preference) {
      .faq-acc__item {
        interpolate-size: allow-keywords;
      }

      .faq-acc__item::details-content {
        height: 0;
        overflow: clip;
        transition:
          height 0.3s ease,
          content-visibility 0.3s allow-discrete;
      }

      .faq-acc__item[open]::details-content {
        height: auto;
      }

      .faq-acc__item.is-instant::details-content {
        transition: none;
      }
    }
  }

  /* ---- Tarjeta de contacto ---- */
  .faq-acc__card {
    padding: 1.5rem;
    border-radius: 1.25rem;
    background:
      radial-gradient(20rem 12rem at 100% 0%, color-mix(in srgb, var(--orange-500) 22%, transparent), transparent 70%),
      var(--teal-900);
    color: var(--white);
    --focus-ring: var(--orange-100);
  }

  .faq-acc__card-title {
    margin: 0 0 0.375rem;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .faq-acc__card-text {
    color: var(--teal-100);
  }

  .faq-acc__card-actions {
    display: grid;
    gap: 0.625rem;
  }

  .faq-acc__call {
    color: var(--white);
  }

  /* ---- Móvil: título, acordeón y, debajo, la tarjeta ---- */
  .faq-acc__side {
    display: contents;
  }

  .faq-acc__head {
    order: 1;
  }

  .faq-acc__list {
    order: 2;
  }

  .faq-acc__card {
    order: 3;
  }

  /* ---- Escritorio: dos columnas, la izquierda fija al hacer scroll ---- */
  @media (min-width: 64rem) {
    .faq-acc {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 3rem;
      align-items: start;
    }

    .faq-acc__side {
      position: sticky;
      top: calc(var(--header-h, 64px) + 1.5rem);
      display: grid;
      gap: 1.75rem;
    }
  }

  /* Sin tarjeta lateral (Nosaltres): título y acordeón en una sola columna centrada. */
  @media (min-width: 64rem) {
    .faq-acc--plain {
      grid-template-columns: minmax(0, 48rem);
      justify-content: center;
      gap: 1.5rem;
    }

    .faq-acc--plain .faq-acc__side {
      position: static;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-acc__chev,
    .faq-acc__item {
      transition: none;
    }
  }
</style>
