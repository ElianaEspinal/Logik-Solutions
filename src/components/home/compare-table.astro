---
// "Pel teu compte o amb Logik": tabla de verdad (accesible) con la columna de Logik destacada
// (teal oscuro, halo de degradado y borde luminoso). Las filas se revelan de una en una.
// En móvil, cada fila es una tarjeta con las dos versiones apiladas.
import type { HomeContent } from './types';

interface Props {
  content: HomeContent['compare'];
}

const { content: c } = Astro.props;
---

<section class="section surface-glow compare-section" aria-labelledby="compare-title" data-section="comparativa">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 id="compare-title">{c.title}</h2>
    </div>

    <div class="cmp">
      <span class="cmp__halo" aria-hidden="true"></span>
      <table class="cmp__table">
        <caption class="sr-only">{c.eyebrow}</caption>
        <thead>
          <tr>
            <th scope="col">{c.topic}</th>
            <th scope="col" class="cmp__self">{c.self}</th>
            <th scope="col" class="cmp__logik">
              <span class="cmp__brand">{c.logik}</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {
            c.rows.map((row, i) => (
              <tr data-reveal style={`--i:${i}`}>
                <th scope="row">{row.topic}</th>
                <td class="cmp__self" data-label={c.self}>
                  <span class="cmp__icon cmp__icon--no" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
                  </span>
                  <span>{row.self}</span>
                </td>
                <td class="cmp__logik" data-label={c.logik}>
                  <span class="cmp__icon cmp__icon--yes" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10" /></svg>
                  </span>
                  <span>{row.logik}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="cmp__close" data-reveal>
      <span class="cmp__close-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7Z" /></svg>
      </span>
      {c.close}
    </p>
  </div>
</section>

<style>
  .cmp {
    position: relative;
    isolation: isolate;
  }

  .cmp__halo {
    display: none;
  }

  .cmp__table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
  }

  /* ---- Móvil: cada fila es una tarjeta ---- */
  .cmp__table,
  .cmp__table tbody,
  .cmp__table tr,
  .cmp__table th,
  .cmp__table td {
    display: block;
  }

  .cmp__table thead {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .cmp__table tbody {
    display: grid;
    gap: 1rem;
  }

  .cmp__table tbody tr {
    overflow: hidden;
    border: 1px solid var(--teal-100);
    border-radius: 1.25rem;
    background: var(--white);
    box-shadow: 0 1rem 2rem -1.5rem color-mix(in srgb, var(--teal-900) 30%, transparent);
  }

  .cmp__table tbody th {
    padding: 1rem 1rem 0.5rem;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    text-align: left;
  }

  .cmp__table td {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.25rem 0.625rem;
    padding: 0.75rem 1rem;
  }

  .cmp__table td::before {
    content: attr(data-label);
    grid-column: 1 / -1;
    font-weight: 700;
  }

  td.cmp__self {
    color: var(--text-muted);
  }

  td.cmp__self::before {
    color: var(--text-muted);
  }

  td.cmp__logik {
    position: relative;
    background:
      radial-gradient(18rem 10rem at 100% 0%, color-mix(in srgb, var(--orange-500) 22%, transparent), transparent 70%),
      var(--teal-900);
    color: var(--white);
  }

  td.cmp__logik::before {
    color: var(--orange-500);
  }

  .cmp__icon {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.05rem;
    border-radius: 50%;
  }

  .cmp__icon--no {
    background: var(--teal-100);
    color: var(--text-muted);
  }

  .cmp__icon--yes {
    background: var(--orange-500);
    color: var(--teal-900);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--orange-500) 25%, transparent);
  }

  /* El check "salta" cuando su fila aparece. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) tr:global(.is-revealed) .cmp__icon--yes {
      animation: cmp-pop 0.5s cubic-bezier(0.3, 1.6, 0.5, 1) both;
      animation-delay: calc(var(--i, 0) * 90ms + 0.25s);
    }
  }

  @keyframes cmp-pop {
    from {
      opacity: 0;
      transform: scale(0.3) rotate(-30deg);
    }
  }

  /* ---- Escritorio: tabla con la columna de Logik destacada ---- */
  @media (min-width: 48rem) {
    .cmp__table {
      display: table;
      table-layout: fixed;
    }

    .cmp__table thead {
      position: static;
      display: table-header-group;
      width: auto;
      height: auto;
      clip-path: none;
    }

    .cmp__table tbody {
      display: table-row-group;
    }

    .cmp__table tr {
      display: table-row;
    }

    .cmp__table tbody tr {
      border: 0;
      background: none;
      box-shadow: none;
    }

    .cmp__table th,
    .cmp__table td {
      display: table-cell;
      padding: 1.125rem 1.25rem;
      border-bottom: 1px solid var(--teal-100);
      text-align: left;
      vertical-align: top;
    }

    .cmp__table td::before {
      content: none;
    }

    .cmp__table thead th {
      padding-block: 1.25rem;
      font-family: var(--font-heading);
      font-size: 1.125rem;
    }

    .cmp__table th:first-child {
      width: 20%;
    }

    .cmp__table tbody th {
      font-family: var(--font-heading);
      font-size: 1.0625rem;
    }

    td.cmp__self,
    th.cmp__self {
      background: color-mix(in srgb, var(--white) 70%, transparent);
    }

    th.cmp__self {
      color: var(--text-muted);
    }

    .cmp__table .cmp__icon {
      margin-right: 0.625rem;
      vertical-align: -0.35rem;
    }

    td.cmp__logik {
      background: var(--teal-900);
      border-bottom-color: color-mix(in srgb, var(--white) 12%, transparent);
    }

    th.cmp__logik {
      border-radius: 1.25rem 1.25rem 0 0;
      background: var(--teal-900);
      color: var(--white);
      border-bottom-color: color-mix(in srgb, var(--white) 12%, transparent);
    }

    .cmp__brand {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .cmp__brand::before {
      content: '';
      width: 0.625rem;
      height: 0.625rem;
      border-radius: 50%;
      background: var(--orange-500);
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--orange-500) 30%, transparent);
    }

    .cmp__table tbody tr:last-child > * {
      border-bottom: 0;
    }

    .cmp__table tbody tr:last-child td.cmp__logik {
      border-radius: 0 0 1.25rem 0;
    }

    /* Halo de degradado y borde luminoso detrás de la columna de Logik (40 % de ancho). */
    .cmp__halo {
      position: absolute;
      top: -0.75rem;
      right: -0.75rem;
      bottom: -0.75rem;
      z-index: -1;
      display: block;
      width: calc(40% + 1.5rem);
      border-radius: 1.75rem;
      background:
        radial-gradient(60% 40% at 50% 0%, color-mix(in srgb, var(--orange-500) 45%, transparent), transparent),
        linear-gradient(180deg, color-mix(in srgb, var(--orange-500) 30%, transparent), color-mix(in srgb, var(--teal-700) 40%, transparent));
      box-shadow:
        0 0 0 1px color-mix(in srgb, var(--orange-500) 45%, transparent),
        0 2rem 4rem -2rem color-mix(in srgb, var(--orange-500) 60%, transparent);
    }
  }

  .cmp__close {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    max-width: 44rem;
    margin: 2.25rem 0 0;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    background: var(--orange-100);
    color: var(--teal-900);
    font-family: var(--font-heading);
    font-size: clamp(1.125rem, 1vw + 0.875rem, 1.375rem);
    font-weight: 700;
    line-height: 1.3;
  }

  .cmp__close-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--teal-900);
    color: var(--orange-500);
  }
</style>
