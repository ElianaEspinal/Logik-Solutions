---
// Pie: datos de la empresa, columnas que reflejan el menú (Per a qui · Serveis · Logik),
// contacto con iconos, mapa (solo tras el consentimiento) y fila inferior con las legales.
// Enlaces sin subrayado (regla global de src/styles/global.css), con objetivos de 44 px.
import { SITE_ENV } from 'astro:env/server';
import { navGroups } from '../config/nav';
import { pages, type Locale, type PageKey } from '../config/pages';
import { addressLine, phone, site } from '../config/site';
import { useTranslations } from '../i18n/ui';
import ConsentEmbed from './ConsentEmbed.astro';

interface Props {
  lang: Locale;
  /** false: sin mapa (la página de contacto ya muestra el suyo). */
  map?: boolean;
}

const { lang, map = true } = Astro.props;
const t = useTranslations(lang);
const isStaging = SITE_ENV === 'staging';
const [forWho, services] = navGroups;
const columns: { title: string; keys: PageKey[] }[] = [
  { title: forWho.label[lang], keys: forWho.items.map((i) => i.page) },
  { title: services.label[lang], keys: [...services.items.map((i) => i.page), 'comTreballem'] },
  { title: 'Logik', keys: ['nosaltres', 'blog', 'contacte'] },
];
const legal = ['avisLegal', 'privacitat', 'cookies'] as const;
const mapQuery = encodeURIComponent(`Carrer Creu 43, ${site.address.locality}`);
const icon = {
  map: '<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>',
  phone:
    '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"/>',
  whatsapp: '<path d="M3 21l1.7-5A8.5 8.5 0 1 1 8 19.4Z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 1a4 4 0 0 1-2-2l1-1-1-2Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
};
---

<footer class="site-footer band-dark" data-section="footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <p class="site-footer__name">{site.name}</p>
      <p class="site-footer__about">{t('footer.about')}</p>
      <address class="site-footer__contact">
        <p class="site-footer__title">{t('footer.contact')}</p>
        <ul>
          <li>
            <span class="site-footer__address">
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon.map} />
              {addressLine(lang)}
            </span>
            {
              isStaging && !site.address.postalCodeVerified && (
                <span class="staging-marker" data-staging-only>
                  {lang === 'ca'
                    ? `PENDENT: verificar el codi postal ${site.address.postalCode} (els de Girona ciutat van del 17001 al 17007)`
                    : `PENDIENTE: verificar el código postal ${site.address.postalCode} (los de Girona ciudad van del 17001 al 17007)`}
                </span>
              )
            }
          </li>
          <li>
            <a href={phone.tel}>
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon.phone} />
              <span><span class="sr-only">{t('footer.phone')} </span>{phone.display}</span>
            </a>
          </li>
          <li>
            <a href={phone.whatsapp} rel="noopener">
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon.whatsapp} />
              <span>WhatsApp<span class="sr-only"> {phone.display}</span></span>
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`}>
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon.mail} />
              <span>{site.email}</span>
            </a>
          </li>
        </ul>
      </address>
    </div>

    <nav class="site-footer__nav" aria-label={t('footer.pages')}>
      {
        columns.map((col) => (
          <div class="site-footer__col">
            <h2 class="site-footer__title">{col.title}</h2>
            <ul class="site-footer__links">
              {col.keys.map((key) => (
                <li>
                  <a href={pages[key][lang]}>{pages[key].name[lang]}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    {
      map && (
        <div class="site-footer__map">
          <ConsentEmbed lang={lang} src={`https://www.google.com/maps?q=${mapQuery}&output=embed`} title={t('footer.map')} ratio="4 / 3" />
        </div>
      )
    }
  </div>

  <div class="container site-footer__bottom">
    <nav aria-label={t('footer.legal')}>
      <ul class="site-footer__legal-links">
        {
          legal.map((key) => (
            <li>
              <a href={pages[key][lang]}>{pages[key].name[lang]}</a>
            </li>
          ))
        }
        <li>
          <!-- Visible solo con JS (sin JS no se carga nada que requiera consentimiento). -->
          <button class="link-button" type="button" data-cookie-open hidden>{t('cookies.settings')}</button>
        </li>
      </ul>
    </nav>
    <p class="site-footer__copy">© {new Date().getFullYear()} {site.legalName} · NIF {site.nif}</p>
  </div>
</footer>
