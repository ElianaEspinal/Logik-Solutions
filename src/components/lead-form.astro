---
// Formulario de captación (cierre "Parlem?" de la home; reutilizable en otras páginas).
// Destino: /api/enviar.php (docs/formulario.md), con hasta 5 facturas adjuntas.
// Sin JS: botón desactivado y aviso <noscript> con teléfono y correo (sin sello no se envía).
// Con JS: validación accesible, sello antispam, envío con FormData, sin doble envío y mensaje de
// éxito en la misma página. generate_lead solo cuando el servidor responde ok.
import { pages, type Locale } from '../config/pages';
import { phone } from '../config/site';
import { useTranslations } from '../i18n/ui';
import { SEND_URL } from '../scripts/form-send';
import FileDrop from './file-drop.astro';

interface Props {
  lang: Locale;
  /** Prefijo de los id (para poder tener más de un formulario en una página). */
  variant?: 'closing';
  /** Texto del botón (por defecto, el del formulario de cierre). */
  submitLabel?: string;
}

const { lang, variant = 'closing', submitLabel } = Astro.props;
const t = useTranslations(lang);
const id = (name: string) => `${variant}-${name}`;
const profiles = ['empresa', 'comunitat', 'llar'] as const;
---

<div class="lead-form" data-form-root>
  <form
    class="lead-form__form"
    action={SEND_URL}
    method="POST"
    enctype="multipart/form-data"
    data-contact-form
    data-variant={variant}
    data-section="cierre"
    data-sending={t('form.sending')}
  >
    <input type="hidden" name="idioma" value={lang} />
    <input type="hidden" name="origen" value="home-cierre" />
    <input type="hidden" name="pagina" value={Astro.url.pathname} />

    <fieldset class="chips" aria-describedby={id('profile-error')}>
      <legend class="chips__legend">{t('form.profile')}</legend>
      <div class="chips__list">
        {
          profiles.map((p) => (
            <label class="chip">
              <input type="radio" name="perfil" value={t(`form.profile.${p}`)} required />
              <span>{t(`form.profile.${p}`)}</span>
            </label>
          ))
        }
      </div>
      <p class="field__error" id={id('profile-error')} data-error-for="perfil" hidden>{t('form.errProfile')}</p>
    </fieldset>

    <div class="field">
      <label for={id('name')}>{t('form.name')}</label>
      <input id={id('name')} name="nom" type="text" autocomplete="name" required minlength="2" maxlength="80" />
      <p class="field__error" id={id('name-error')} data-error-for="nom" hidden>{t('form.errName')}</p>
    </div>

    <div class="field">
      <label for={id('phone')}>{t('form.phone')}</label>
      <input id={id('phone')} name="telefon" type="tel" inputmode="tel" autocomplete="tel" required maxlength="20" pattern="\+?[0-9 \.\(\)\-]{9,20}" />
      <p class="field__error" id={id('phone-error')} data-error-for="telefon" hidden>{t('form.errPhone')}</p>
    </div>

    <div class="field">
      <label for={id('email')}>{t('form.email')}</label>
      <input id={id('email')} name="email" type="email" inputmode="email" autocomplete="email" maxlength="254" />
      <p class="field__error" id={id('email-error')} data-error-for="email" hidden>{t('form.errEmail')}</p>
    </div>

    <FileDrop lang={lang} idPrefix={variant} />

    <div class="field consent">
      <input id={id('consent')} name="consentiment" type="checkbox" value="acceptat" required />
      <label for={id('consent')}>
        {
          t('form.consent')
            .split(t('form.consentLink'))
            .map((part, i, all) => (
              <>
                {part}
                {i < all.length - 1 && (
                  <a href={pages.privacitat[lang]} target="_blank" rel="noopener">
                    {t('form.consentLink')}
                  </a>
                )}
              </>
            ))
        }
      </label>
      <p class="field__error" id={id('consent-error')} data-error-for="consentiment" hidden>{t('form.errConsent')}</p>
    </div>
    {/* Primera capa de información (LOPDGDD, art. 11): responsable, finalidad, derechos y enlace. */}
    <p class="form-privacy" id={id('privacy-info')}>
      {t('form.privacyInfo').split(t('form.consentLink'))[0]}<a href={pages.privacitat[lang]} target="_blank" rel="noopener">{t('form.consentLink')}</a>{t('form.privacyInfo').split(t('form.consentLink'))[1]}
    </p>

    <!-- Honeypot antispam: fuera de la vista; las personas no lo ven ni lo enfocan. -->
    <div class="lead-form__trap" aria-hidden="true">
      <label for={id('website')}>Website</label>
      <input id={id('website')} type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    </div>

    <p class="sr-only" aria-live="polite" data-form-live></p>
    <div class="lead-form__error" role="alert" data-form-error hidden>
      <div data-form-error-text><p>{t('form.error')}</p></div>
      <a class="btn btn-secondary" href={phone.tel}>{t('cta.callAt')} {phone.display}</a>
    </div>

    <noscript>
      <p class="lead-form__note">{t('form.noscript')}</p>
    </noscript>

    <!-- Desactivado sin JavaScript: lo activa el script de abajo. -->
    <button class="btn btn-primary btn-lg lead-form__submit" type="submit" disabled data-submit>
      <span class="lead-form__spinner" aria-hidden="true"></span>
      <span data-submit-label>{submitLabel ?? t('form.submit')}</span>
    </button>
  </form>

  <div class="lead-form__success" tabindex="-1" data-form-success hidden>
    <svg class="lead-form__check" aria-hidden="true" width="64" height="64" viewBox="0 0 52 52">
      <circle cx="26" cy="26" r="24" fill="none" stroke-width="3"></circle>
      <path d="m15 27 7 7 15-16" fill="none" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    <p role="status">{t('form.success')}</p>
    <div class="lead-form__note" data-form-success-note hidden></div>
    <a class="btn btn-secondary" href={phone.whatsapp} rel="noopener">{t('cta.whatsappLong')}</a>
  </div>
</div>

<script>
  import { sectionOf, trackThen } from '../scripts/analytics';
  import { fileErrorText, filesError, initFileDrop } from '../scripts/file-drop';
  import { discardedMessage, guardCheck, hideGuardMessage, markSent, renderText, resultMessage, showGuardMessage } from '../scripts/form-guard';
  import { appendFiles, armSeal, submitForm } from '../scripts/form-send';
  import { nameValid, phoneValid } from '../lib/contact';

  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  document.querySelectorAll<HTMLElement>('[data-form-root]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('form[data-contact-form]')!;
    const success = root.querySelector<HTMLElement>('[data-form-success]')!;
    const successNote = root.querySelector<HTMLElement>('[data-form-success-note]')!;
    const live = form.querySelector<HTMLElement>('[data-form-live]')!;
    const errorBox = form.querySelector<HTMLElement>('[data-form-error]')!;
    const errorText = form.querySelector<HTMLElement>('[data-form-error-text]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = submit.querySelector<HTMLElement>('[data-submit-label]')!;
    const dropEl = form.querySelector<HTMLElement>('[data-drop]');
    const drop = dropEl
      ? initFileDrop(dropEl, (files, code) => {
          if (code === null && files.length) live.textContent = files.map((f) => f.name).join(', ');
        })
      : null;

    form.noValidate = true; // con JS validamos nosotros, con mensajes accesibles
    armSeal(form);
    submit.disabled = false; // sin JS queda desactivado (no hay sello)

    // --- Validación (mismas reglas que el servidor) ---------------------------------
    const errorEl = (name: string) => form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
    const defaults = new Map<string, string>();
    function setError(name: string, invalid: boolean, message?: string) {
      const error = errorEl(name);
      if (!error) return;
      if (!defaults.has(name)) defaults.set(name, error.textContent ?? '');
      error.textContent = message ?? defaults.get(name) ?? '';
      error.hidden = !invalid;
      form.querySelectorAll<HTMLInputElement>(`[name="${name}"]`).forEach((input) => {
        if (input.type === 'radio') return; // el grupo ya está descrito por el fieldset
        const rest = (input.getAttribute('aria-describedby') ?? '').split(' ').filter((x) => x && x !== error.id);
        if (invalid) {
          input.setAttribute('aria-invalid', 'true');
          input.setAttribute('aria-describedby', [error.id, ...rest].join(' '));
        } else {
          input.removeAttribute('aria-invalid');
          if (rest.length) input.setAttribute('aria-describedby', rest.join(' '));
          else input.removeAttribute('aria-describedby');
        }
      });
      form.querySelector(`fieldset:has([name="${name}"])`)?.classList.toggle('is-invalid', invalid);
    }

    const value = (name: string) => ((form.elements.namedItem(name) as HTMLInputElement | null)?.value ?? '').trim();
    const rules: [string, () => boolean][] = [
      ['perfil', () => !form.querySelector('[name="perfil"]:checked')],
      ['nom', () => !nameValid(value('nom'))],
      ['telefon', () => !phoneValid(value('telefon'))],
      ['email', () => !!value('email') && (value('email').length > 254 || !EMAIL.test(value('email')))],
      ['consentiment', () => !(form.elements.namedItem('consentiment') as HTMLInputElement).checked],
    ];

    const validate = (only?: string) => {
      let first: string | null = null;
      for (const [name, invalid] of rules) {
        if (only && only !== name) continue;
        const bad = invalid();
        setError(name, bad);
        if (bad && !first) first = name;
      }
      return first;
    };

    // Validación en línea: al salir de cada campo y, tras un intento, en cada cambio.
    let tried = false;
    form.addEventListener('focusout', (e) => {
      // Si el foco va al botón de envío, valida el envío (evita mover el botón bajo el cursor).
      if ((e as FocusEvent).relatedTarget === submit) return;
      const input = e.target as HTMLInputElement;
      if (input.type === 'file') return;
      if (input.name && (tried || value(input.name))) validate(input.name);
    });
    form.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (tried && input.name && input.type !== 'file') validate(input.name);
    });
    // Mientras se escribe, un error ya visible se quita en cuanto el valor es válido.
    // Así el formulario no cambia de altura justo al pulsar "Enviar" (el clic no se pierde).
    form.addEventListener('input', (e) => {
      const name = (e.target as HTMLInputElement).name;
      if (name && errorEl(name) && !errorEl(name)!.hidden) validate(name);
    });

    // --- Envío ----------------------------------------------------------------
    let sending = false;
    const label = submitLabel.textContent ?? '';
    const setSending = (on: boolean) => {
      sending = on;
      submit.disabled = on;
      if (on) submit.setAttribute('aria-busy', 'true');
      else submit.removeAttribute('aria-busy');
      submitLabel.textContent = on ? (form.dataset.sending ?? label) : label;
      if (on) live.textContent = form.dataset.sending ?? '';
    };
    const showError = (text: string) => {
      setSending(false);
      renderText(errorText, text);
      errorBox.hidden = false;
      live.textContent = text;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return; // sin doble envío
      tried = true;
      errorBox.hidden = true;
      const firstInvalid = validate();
      if (firstInvalid) {
        live.textContent = errorEl(firstInvalid)?.textContent ?? '';
        form.querySelector<HTMLInputElement>(`[name="${firstInvalid}"]`)?.focus();
        return;
      }

      // Enlaces, etiquetas, alfabeto y enfriamiento: avisa antes de que el servidor lo descarte.
      const blocked = guardCheck(form);
      if (blocked) {
        showGuardMessage(form, blocked[0], submit);
        if (blocked[1]) form.querySelector<HTMLElement>(`[name="${blocked[1]}"]`)?.focus();
        return;
      }
      hideGuardMessage(form);

      setSending(true);
      const data = new FormData(form);
      const files = await appendFiles(data, drop?.files() ?? []);
      const fileProblem = filesError(files);
      if (fileProblem) {
        setSending(false);
        drop?.showError(fileProblem);
        live.textContent = fileErrorText(fileProblem);
        drop?.input.focus();
        return;
      }

      const result = await submitForm(form, data);
      if (result.kind === 'ok') {
        trackThen('generate_lead', { form_location: sectionOf(form) }, () => {
          const note = discardedMessage(result.discarded, result.notSent);
          if (note) renderText(successNote, note);
          successNote.hidden = !note;
          form.hidden = true;
          success.hidden = false;
          success.focus();
        });
      } else if (result.kind === 'invalid') {
        setSending(false);
        let first: string | null = null;
        for (const [name, message] of Object.entries(result.errors)) {
          if (!errorEl(name)) continue;
          setError(name, true, message);
          first ??= name;
        }
        if (first) form.querySelector<HTMLInputElement>(`[name="${first}"]`)?.focus();
        else showError(resultMessage(result));
      } else {
        showError(resultMessage(result));
        if (result.kind !== 'tooLarge') markSent(submit); // enfriamiento de 30 s tras un fallo
      }
    });
  });
</script>

<style>
  .lead-form__form {
    display: grid;
    gap: 1rem;
  }

  .lead-form__form[hidden] {
    display: none;
  }

  .lead-form .field {
    margin: 0;
  }

  .lead-form input:not([type='checkbox'], [type='radio'], [type='file']) {
    min-height: 52px;
    border-radius: 0.75rem;
  }

  .lead-form input:focus-visible {
    border-color: var(--orange-700);
    outline: 3px solid var(--orange-500);
    outline-offset: 1px;
  }

  /* --- Chips de perfil (radio accesible) --- */
  .chips {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .chips__legend {
    margin-bottom: 0.5rem;
    padding: 0;
    font-weight: 700;
  }

  .chips__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    position: relative;
    display: inline-flex;
    margin: 0;
    font-weight: 600;
    cursor: pointer;
  }

  .chip input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 1.5px solid var(--teal-100);
    border-radius: 999px;
    background: var(--white);
    color: var(--teal-900);
    transition:
      background-color 0.15s,
      border-color 0.15s;
  }

  .chip input:checked + span {
    border-color: var(--teal-900);
    background: var(--teal-900);
    color: var(--white);
  }

  .chip input:checked + span::before {
    content: '✓';
    margin-right: 0.375rem;
    color: var(--orange-500);
  }

  .chip input:focus-visible + span {
    outline: 3px solid var(--orange-500);
    outline-offset: 2px;
  }

  @media (hover: hover) {
    .chip:hover span {
      border-color: var(--teal-900);
    }
  }

  .chips.is-invalid .chip span {
    border-color: var(--orange-700);
  }

  /* --- Consentimiento --- */
  .consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 0.75rem;
    align-items: start;
  }

  .consent label {
    font-weight: 400;
  }

  .consent .field__error {
    grid-column: 1 / -1;
  }

  .lead-form__note {
    margin: 0;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    background: var(--teal-100);
    color: var(--teal-900);
  }

  .lead-form__note[hidden] {
    display: none;
  }

  /* Texto creado por el script (mensajes con enlaces al teléfono y al correo). */
  .lead-form__note :global(p) {
    margin: 0;
    font-size: 1rem;
  }

  .lead-form__note :global(a),
  .lead-form__error :global(a:not(.btn)) {
    color: var(--teal-900);
  }

  /* --- Honeypot (fuera de la vista; no display:none) --- */
  .lead-form__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* --- Estados --- */
  .lead-form__error {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: 0.75rem;
    background: var(--orange-100);
    color: var(--teal-900);
    font-weight: 700;
  }

  .lead-form__error[hidden] {
    display: none;
  }

  .lead-form__error :global(p) {
    margin: 0;
  }

  .lead-form__submit {
    width: 100%;
    min-height: 56px;
  }

  .lead-form__spinner {
    display: none;
    width: 1.125rem;
    height: 1.125rem;
    border: 2.5px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: spin-btn 0.7s linear infinite;
  }

  .lead-form__submit[aria-busy='true'] .lead-form__spinner {
    display: inline-block;
  }

  @keyframes spin-btn {
    to {
      transform: rotate(360deg);
    }
  }

  .lead-form__success {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding: 1.5rem 0.5rem;
    color: var(--teal-900);
    font-size: 1.125rem;
    font-weight: 700;
    text-align: center;
  }

  .lead-form__success[hidden] {
    display: none;
  }

  .lead-form__success p {
    margin: 0;
  }

  .lead-form__check {
    stroke: var(--orange-700);
  }

  .lead-form__check circle {
    stroke-dasharray: 151;
    stroke-dashoffset: 151;
    animation: draw 0.6s ease-out forwards;
  }

  .lead-form__check path {
    stroke-dasharray: 40;
    stroke-dashoffset: 40;
    animation: draw 0.4s 0.45s ease-out forwards;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lead-form__check circle,
    .lead-form__check path {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
</style>
