---
// Llars / Hogares. Un solo objetivo: que un particular entienda su factura de luz y gas, sienta
// que alguien se ocupa y empiece el pre-estudi (o llame). Tono cálido y sin tecnicismos.
// Orden: hero · cifras · factura interactiva · la potència de casa · què et preocupa? (chat) ·
// per aprofundir (blog, si hay) · FAQ · pre-estudi.
// Solo datos confirmados (docs/contexto.md). Sin fotos de personas ni cifras en las ilustraciones:
// barras y líneas en SVG de marca, siempre decorativas (aria-hidden).
// Reutiliza: stats-strip, faq-accordion, post-card y pre-study (perfil "llar" ya resuelto,
// pagina_origen = "llars").
// Medición: cta_click (llars_hero, llars_factura, llars_preocupacio, llars_cierre),
// factura_hotspot_click { bloc }, preocupacio_select { opcio }, click_call (location = llars),
// blog_card_click (location = llars) y los del pre-estudi (calc_start, calc_step, generate_lead).
import FaqAccordion from '../home/faq-accordion.astro';
import PreStudy from '../home/pre-study.astro';
import { preStudyTexts } from '../home/pre-study-texts';
import StatsStrip from '../stats-strip.astro';
import PostCard from '../blog/post-card.astro';
import { PRE_STUDY_ID } from '../../config/home';
import { pages, type Locale } from '../../config/pages';
import { phone } from '../../config/site';
import { getPublishedPosts } from '../../lib/blog';
import type { HomesContent } from './types';
import '../../styles/motion.css';

interface Props {
  lang: Locale;
  content: HomesContent;
}

const { lang, content: c } = Astro.props;
const words = c.hero.title.split(' ');
const noArrow = (s: string) => s.replace(/\s*→$/, '');
const studyHref = `#${PRE_STUDY_ID[lang]}`;

// "Per aprofundir": hasta 3 artículos publicados del idioma; primero "Factura i potència",
// después los temas que también interesan a una llar (gestions y autoconsum).
const published = await getPublishedPosts(lang);
const related = [
  ...published.filter((p) => p.data.category === 'factura'),
  ...published.filter((p) => p.data.category === 'gestions'),
  ...published.filter((p) => p.data.category === 'autoconsum'),
].slice(0, 3);

const phoneIcon =
  '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"/>';
// Ventanas de la casa del hero: [x, y]. Se encienden por turnos.
const windows: [number, number][] = [
  [74, 132],
  [156, 132],
  [74, 180],
  [156, 180],
];
---

<!-- 1. Hero -->
<section class="lr-hero tech-bg" aria-labelledby="lr-title" data-section="llars">
  <div class="lr-hero__mesh" aria-hidden="true" data-anim>
    <span class="lr-hero__blob lr-hero__blob--a"></span>
    <span class="lr-hero__blob lr-hero__blob--b"></span>
  </div>
  <div class="container lr-hero__grid">
    <div>
      <p class="lr-hero__tag"><span class="lr-hero__pulse" aria-hidden="true"></span>{c.hero.tag}</p>
      <h1 id="lr-title">
        {
          words.map((word, i) => (
            <>
              <span class="lr-hero__word" style={`--w:${i}`}>
                {word}
              </span>
              {i < words.length - 1 && ' '}
            </>
          ))
        }
      </h1>
      <p class="lr-hero__lead">{c.hero.lead}</p>
      <a class="btn btn-primary btn-lg lr-hero__btn" href={studyHref} data-cta="llars_hero">
        {noArrow(c.hero.cta)} <span class="arrow" aria-hidden="true">→</span>
      </a>
      <p class="lr-hero__note">{c.hero.note}</p>
      <a class="lr-call" href={phone.tel}>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={phoneIcon} />
        <span>{c.hero.call} {phone.display}</span>
      </a>
    </div>

    <!-- Casa con ventanas que se encienden por turnos y una factura que flota al lado (sus líneas
         se "ordenan" al cargar). Decorativa: sin texto ni cifras. Tamaño fijo por CSS (sin CLS). -->
    <div class="lr-house" aria-hidden="true" data-anim>
      <svg viewBox="0 0 320 250" width="320" height="250" focusable="false">
        <ellipse class="lr-house__ground" cx="138" cy="234" rx="118" ry="7"></ellipse>
        <rect class="lr-house__chimney" x="168" y="60" width="18" height="40" rx="2"></rect>
        <rect class="lr-house__body" x="54" y="110" width="152" height="122" rx="6"></rect>
        <path class="lr-house__roof" d="M38 122 130 50l92 72"></path>
        {
          windows.map(([x, y], i) => (
            <g style={`--n:${i}`}>
              <rect class="lr-house__win" x={x} y={y} width="32" height="28" rx="4" />
              <rect class="lr-house__light" x={x} y={y} width="32" height="28" rx="4" />
              <path class="lr-house__frame" d={`M${x + 16} ${y}v28M${x} ${y + 14}h32`} />
            </g>
          ))
        }
        <rect class="lr-house__door" x="116" y="178" width="30" height="54" rx="4"></rect>
        <g class="lr-house__float">
          <g transform="rotate(6 258 126)">
            <rect class="lr-house__paper" x="214" y="70" width="88" height="114" rx="9"></rect>
            <rect class="lr-house__head" x="226" y="84" width="40" height="8" rx="4"></rect>
            <rect class="lr-house__line" style="--l:0" x="226" y="104" width="64" height="6" rx="3"></rect>
            <rect class="lr-house__line" style="--l:1" x="226" y="118" width="50" height="6" rx="3"></rect>
            <rect class="lr-house__line" style="--l:2" x="226" y="132" width="58" height="6" rx="3"></rect>
            <rect class="lr-house__line" style="--l:3" x="226" y="146" width="40" height="6" rx="3"></rect>
            <rect class="lr-house__line lr-house__line--accent" style="--l:4" x="226" y="164" width="30" height="8" rx="4"></rect>
          </g>
        </g>
      </svg>
    </div>
  </div>
</section>

<StatsStrip items={c.stats} section="llars" />

<!-- 2. Factura interactiva: los tres textos están en el HTML. Sin JS o en móvil, lista de tres
     tarjetas; en escritorio con JS, una tarjeta junto a la factura según el punto activo. -->
<section class="section surface-white surface-grid" aria-labelledby="lr-bill-title" data-section="llars">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{c.bill.eyebrow}</p>
      <h2 id="lr-bill-title">{c.bill.title}</h2>
      <p class="section-head__intro">{c.bill.intro}</p>
    </div>

    <div class="lr-ib" data-ib data-active={c.bill.items[0].key}>
      <div class="lr-ib__figure" data-reveal>
        <svg class="lr-ib__svg" viewBox="0 0 300 380" width="300" height="380" aria-hidden="true" focusable="false">
          <rect class="lr-ib__paper" x="4" y="4" width="292" height="372" rx="16"></rect>
          <rect class="lr-ib__ink" x="26" y="28" width="92" height="12" rx="6"></rect>
          <rect class="lr-ib__soft" x="26" y="50" width="150" height="7" rx="3.5"></rect>
          <rect class="lr-ib__soft" x="200" y="28" width="74" height="7" rx="3.5"></rect>
          <rect class="lr-ib__soft" x="220" y="42" width="54" height="7" rx="3.5"></rect>

          <!-- Potència -->
          <g>
            <rect class="lr-ib__blk" x="18" y="80" width="264" height="82" rx="12"></rect>
            <rect class="lr-ib__hl lr-ib__hl--potencia" x="18" y="80" width="264" height="82" rx="12"></rect>
            <rect class="lr-ib__ink" x="34" y="96" width="74" height="10" rx="5"></rect>
            <rect class="lr-ib__soft" x="34" y="116" width="150" height="7" rx="3.5"></rect>
            <rect class="lr-ib__soft" x="34" y="132" width="118" height="7" rx="3.5"></rect>
            <rect class="lr-ib__acc" x="196" y="114" width="40" height="10" rx="5"></rect>
          </g>
          <!-- Energia: mini gráfico de barras, sin cifras -->
          <g>
            <rect class="lr-ib__blk" x="18" y="176" width="264" height="96" rx="12"></rect>
            <rect class="lr-ib__hl lr-ib__hl--energia" x="18" y="176" width="264" height="96" rx="12"></rect>
            <rect class="lr-ib__ink" x="34" y="192" width="64" height="10" rx="5"></rect>
            <rect class="lr-ib__bar" x="34" y="236" width="14" height="22" rx="3"></rect>
            <rect class="lr-ib__bar" x="54" y="224" width="14" height="34" rx="3"></rect>
            <rect class="lr-ib__bar" x="74" y="230" width="14" height="28" rx="3"></rect>
            <rect class="lr-ib__bar" x="94" y="216" width="14" height="42" rx="3"></rect>
            <rect class="lr-ib__bar" x="114" y="226" width="14" height="32" rx="3"></rect>
            <rect class="lr-ib__soft" x="146" y="220" width="70" height="7" rx="3.5"></rect>
            <rect class="lr-ib__acc" x="146" y="236" width="48" height="10" rx="5"></rect>
          </g>
          <!-- Impostos i altres conceptes -->
          <g>
            <rect class="lr-ib__blk" x="18" y="286" width="264" height="72" rx="12"></rect>
            <rect class="lr-ib__hl lr-ib__hl--impostos" x="18" y="286" width="264" height="72" rx="12"></rect>
            <rect class="lr-ib__ink" x="34" y="300" width="96" height="10" rx="5"></rect>
            <rect class="lr-ib__soft" x="34" y="320" width="132" height="7" rx="3.5"></rect>
            <rect class="lr-ib__soft" x="34" y="336" width="96" height="7" rx="3.5"></rect>
            <rect class="lr-ib__acc" x="196" y="318" width="34" height="10" rx="5"></rect>
          </g>
        </svg>
        <div class="lr-ib__spots" role="group" aria-label={c.bill.label}>
          {
            c.bill.items.map((item, i) => (
              <button
                class:list={['lr-ib__spot', `lr-ib__spot--${item.key}`]}
                type="button"
                aria-expanded={i === 0 ? 'true' : 'false'}
                aria-controls={`lr-ib-${item.key}`}
                data-ib-spot={item.key}
              >
                <span class="lr-ib__dot" aria-hidden="true" />
                <span class="sr-only">{item.title}</span>
              </button>
            ))
          }
        </div>
      </div>

      <ol class="lr-ib__list">
        {
          c.bill.items.map((item, i) => (
            <li class="lr-ib__item card" id={`lr-ib-${item.key}`} data-ib-item={item.key}>
              <span class="lr-ib__num" aria-hidden="true">
                {i + 1}
              </span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="lr-ib__close" data-reveal>
      <p>{c.bill.close}</p>
      <a class="btn btn-primary" href={studyHref} data-cta="llars_factura">
        {noArrow(c.bill.cta)} <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<!-- 3. La potència de casa: medidor decorativo (aguja que oscila; con reduced-motion, en "Ajustada"). -->
<section class="section lr-power-section" aria-labelledby="lr-power-title" data-section="llars">
  <div class="container lr-power">
    <div class="lr-dial" aria-hidden="true" data-anim data-reveal>
      <svg viewBox="0 0 300 170" width="300" height="170" focusable="false">
        <path class="lr-dial__zone" d="M34 150a116 116 0 0 1 58-100.46"></path>
        <path class="lr-dial__zone lr-dial__zone--ok" d="M95.6 47.6a116 116 0 0 1 108.8 0"></path>
        <path class="lr-dial__zone" d="M208 49.54A116 116 0 0 1 266 150"></path>
        <g class="lr-dial__needle">
          <path d="M150 150V58"></path>
        </g>
        <circle class="lr-dial__hub" cx="150" cy="150" r="10"></circle>
      </svg>
      <div class="lr-dial__labels">
        <span>{c.power.zones[0]}</span>
        <span class="lr-dial__label--ok">{c.power.zones[1]}</span>
        <span>{c.power.zones[2]}</span>
      </div>
    </div>
    <div class="lr-power__text" data-reveal>
      <p class="eyebrow">{c.power.eyebrow}</p>
      <h2 id="lr-power-title">{c.power.title}</h2>
      <p class="lr-power__p">{c.power.text}</p>
      <a class="lr-arrow-link" href={pages.gestio[lang]}>
        {noArrow(c.power.link)} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<!-- 4. Què et preocupa? Selector en formato de chat. Sin JS: todas las respuestas en lista, cada una
     con su frase. Con JS: una respuesta visible (las demás con hidden), en la misma celda de rejilla
     que la más larga (sin CLS). -->
<section class="section band-alt" aria-labelledby="lr-chat-title" data-section="llars">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{c.chat.eyebrow}</p>
      <h2 id="lr-chat-title">{c.chat.title}</h2>
      <p class="section-head__intro">{c.chat.intro}</p>
    </div>

    <div class="lr-chat" data-chat data-reveal>
      <div class="lr-chat__picker" role="radiogroup" aria-label={c.chat.label}>
        {
          c.chat.items.map((item, i) => (
            <button
              class="lr-chat__q-btn"
              type="button"
              role="radio"
              aria-checked={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? '0' : '-1'}
              aria-controls={`lr-chat-a${i + 1}`}
              data-chat-opt={i + 1}
            >
              {item.q}
            </button>
          ))
        }
      </div>

      <div class="lr-chat__reply">
        <span class="lr-chat__avatar" aria-hidden="true">
          <svg viewBox="160 134 80 132" width="22" height="36" focusable="false"><path d="M214 140 168 212h30l-12 48 46-72h-30Z"></path></svg>
        </span>
        <div class="lr-chat__answers" aria-live="polite" aria-label={c.chat.answerLabel} data-chat-answers>
          <span class="lr-chat__typing" aria-hidden="true"><i></i><i></i><i></i></span>
          {
            c.chat.items.map((item, i) => (
              <div class="lr-chat__answer" id={`lr-chat-a${i + 1}`} data-chat-answer={i + 1}>
                <p class="lr-chat__q">{item.q}</p>
                <p class="lr-chat__a">{item.a}</p>
                {item.action.kind === 'study' ? (
                  <a class="btn btn-primary lr-chat__btn" href={studyHref} data-cta="llars_preocupacio">
                    {noArrow(item.action.label)} <span class="arrow" aria-hidden="true">→</span>
                  </a>
                ) : (
                  <a class="lr-arrow-link" href={pages[item.action.page][lang]} data-cta="llars_preocupacio">
                    {noArrow(item.action.label)} <span aria-hidden="true">→</span>
                  </a>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 5. Per aprofundir: solo si hay artículos publicados (si no, ni el título ni el hueco) -->
{
  related.length > 0 && (
    <section class="section surface-white" aria-labelledby="lr-blog-title" data-section="llars" data-lr-blog>
      <div class="container">
        <h2 id="lr-blog-title" class="lr-h2" data-reveal>
          {c.blogTitle}
        </h2>
        <div class="lr-posts">
          {related.map((post, i) => (
            <PostCard post={post} lang={lang} position={i + 1} heading="h3" />
          ))}
        </div>
      </div>
    </section>
  )
}

<!-- 6. Preguntes freqüents (6, acordeón exclusivo; el JSON-LD FAQPage sale de los mismos textos) -->
<FaqAccordion lang={lang} content={c.faq} idPrefix="lr-faq" section="llars" />

<!-- 7. Pre-estudi de la llar: perfil "llar" ya resuelto -->
<PreStudy
  lang={lang}
  content={{ ...preStudyTexts[lang], title: c.study.title, lead: c.study.lead }}
  presetProfile="llar"
  origin="llars"
/>
<div class="lr-after" data-section="llars">
  <div class="container lr-after__inner">
    <p class="lr-after__call">
      {c.study.callLead}{' '}
      <a href={phone.tel} data-cta="llars_cierre">{phone.display}</a>
    </p>
    <p class="lr-after__other">
      <span>{c.study.other}</span>
      <a class="lr-arrow-link" href={pages.empreses[lang]}>{pages.empreses.name[lang]} <span aria-hidden="true">→</span></a>
      <a class="lr-arrow-link" href={pages.comunitats[lang]}>{pages.comunitats.name[lang]} <span aria-hidden="true">→</span></a>
    </p>
  </div>
</div>

<script>
  import { track } from '../../scripts/analytics';
  import { initDecor, initReveal } from '../../scripts/motion';

  initReveal();
  initDecor();

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const desktop = window.matchMedia('(min-width: 48rem)');

  // --- Factura interactiva: un punto activo a la vez; flechas para moverse entre puntos.
  document.querySelectorAll<HTMLElement>('[data-ib]').forEach((root) => {
    const spots = [...root.querySelectorAll<HTMLButtonElement>('[data-ib-spot]')];
    const activate = (spot: HTMLButtonElement, fromUser: boolean) => {
      const key = spot.dataset.ibSpot!;
      root.dataset.active = key;
      spots.forEach((s) => s.setAttribute('aria-expanded', String(s === spot)));
      root.querySelectorAll<HTMLElement>('[data-ib-item]').forEach((item) => item.classList.toggle('is-active', item.dataset.ibItem === key));
      if (!fromUser) return;
      track('factura_hotspot_click', { bloc: key, location: 'llars' });
      // En móvil la explicación está debajo de la factura: se acerca a la vista si hace falta.
      if (!desktop.matches) {
        root.querySelector(`[data-ib-item="${key}"]`)?.scrollIntoView({ block: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
      }
    };
    spots.forEach((spot, i) => {
      spot.addEventListener('click', () => activate(spot, true));
      spot.addEventListener('keydown', (event) => {
        const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[event.key];
        if (!step) return;
        event.preventDefault();
        const next = spots[(i + step + spots.length) % spots.length];
        next.focus();
        activate(next, true);
      });
    });
    activate(spots[0], false);
  });

  // --- Què et preocupa?: radiogroup con tabindex móvil; respuesta con "escribiendo…" breve.
  document.querySelectorAll<HTMLElement>('[data-chat]').forEach((chat) => {
    const options = [...chat.querySelectorAll<HTMLButtonElement>('[data-chat-opt]')];
    const box = chat.querySelector<HTMLElement>('[data-chat-answers]')!;
    const answers = [...box.querySelectorAll<HTMLElement>('[data-chat-answer]')];
    let timer = 0;
    const select = (option: HTMLButtonElement, fromUser: boolean) => {
      const n = option.dataset.chatOpt!;
      if (fromUser && option.getAttribute('aria-checked') === 'true') return;
      options.forEach((o) => {
        const on = o === option;
        o.setAttribute('aria-checked', String(on));
        o.tabIndex = on ? 0 : -1;
      });
      answers.forEach((a) => (a.hidden = a.dataset.chatAnswer !== n));
      window.clearTimeout(timer);
      if (fromUser) {
        track('preocupacio_select', { opcio: Number(n), location: 'llars' });
        if (!reduce) {
          box.classList.add('is-typing');
          timer = window.setTimeout(() => box.classList.remove('is-typing'), 650);
        }
      }
    };
    options.forEach((option, i) => {
      option.addEventListener('click', () => select(option, true));
      option.addEventListener('keydown', (event) => {
        const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[event.key];
        if (!step) return;
        event.preventDefault();
        const next = options[(i + step + options.length) % options.length];
        next.focus();
        select(next, true);
      });
    });
    select(options[0], false);
  });

  // --- Per aprofundir: blog_card_click con location = llars.
  document.querySelector('[data-lr-blog]')?.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-card-link]');
    if (!link) return;
    const { slug, position, lang } = link.dataset;
    track('blog_card_click', { slug, position: Number(position), lang, location: 'llars' });
  });
</script>

<style>
  /* ---------------- 1. Hero ---------------- */
  .lr-hero {
    padding-block: 1.5rem 3rem;
    color: var(--white);
  }

  .lr-hero__mesh {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .lr-hero__blob {
    position: absolute;
    width: 34rem;
    height: 34rem;
    border-radius: 50%;
    opacity: 0.55;
    animation: lr-drift 28s ease-in-out infinite alternate;
  }

  .lr-hero__blob--a {
    top: -14rem;
    right: -12rem;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--orange-500) 45%, transparent), transparent);
  }

  .lr-hero__blob--b {
    bottom: -18rem;
    left: -14rem;
    background: radial-gradient(closest-side, var(--teal-700), transparent);
    animation-duration: 34s;
    animation-direction: alternate-reverse;
  }

  @keyframes lr-drift {
    to {
      transform: translate3d(-6rem, 4rem, 0) scale(1.15);
    }
  }

  .lr-hero__grid {
    display: grid;
    gap: 1.5rem;
  }

  .lr-hero__tag {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    margin-bottom: 0.875rem;
    padding: 0.25rem 0.875rem 0.25rem 0.625rem;
    border: 1px solid color-mix(in srgb, var(--white) 25%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--white) 8%, transparent);
    font-weight: 700;
  }

  .lr-hero__pulse {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--orange-500);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--orange-500) 30%, transparent);
  }

  .lr-hero h1 {
