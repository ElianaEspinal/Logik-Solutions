---
// Portada de marca para artículos sin imagen: degradado teal, cuadrícula, icono de la categoría y rayo.
// Solo CSS y SVG en línea (sin imágenes externas). Decorativa: aria-hidden.
import { CATEGORY_ICONS, type CategoryKey } from '../../config/blog';

interface Props {
  category: CategoryKey;
  size?: 'card' | 'hero';
}

const { category, size = 'card' } = Astro.props;
---

<div class:list={['brand-cover', `brand-cover--${size}`]} aria-hidden="true">
  <svg class="brand-cover__bolt" viewBox="0 0 100 100" width="100" height="100" focusable="false">
    <path d="M58 6 26 56h20l-8 38 34-52H52Z"></path>
  </svg>
  <span class="brand-cover__icon">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" focusable="false" set:html={CATEGORY_ICONS[category]} />
  </span>
</div>

<style>
  .brand-cover {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background:
      linear-gradient(color-mix(in srgb, var(--white) 7%, transparent) 1px, transparent 1px) 0 0 / 1.75rem 1.75rem,
      linear-gradient(90deg, color-mix(in srgb, var(--white) 7%, transparent) 1px, transparent 1px) 0 0 / 1.75rem 1.75rem,
      radial-gradient(70% 90% at 100% 0%, color-mix(in srgb, var(--orange-500) 30%, transparent), transparent 70%),
      radial-gradient(60% 80% at 0% 100%, var(--teal-700), transparent 70%),
      var(--teal-900);
  }

  .brand-cover__bolt {
    position: absolute;
    right: 6%;
    bottom: -8%;
    width: 46%;
    height: auto;
    max-width: none;
    fill: color-mix(in srgb, var(--orange-500) 22%, transparent);
  }

  .brand-cover__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border: 1px solid color-mix(in srgb, var(--white) 22%, transparent);
    border-radius: 1.125rem;
    background: color-mix(in srgb, var(--teal-900) 60%, transparent);
    color: var(--orange-500);
    box-shadow: 0 0 2.5rem -0.5rem color-mix(in srgb, var(--orange-500) 55%, transparent);
  }

  .brand-cover--hero .brand-cover__icon {
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 1.5rem;
  }

  .brand-cover--hero .brand-cover__icon svg {
    width: 44px;
    height: 44px;
  }
</style>
