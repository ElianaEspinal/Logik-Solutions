---
// Índice del blog (/blog/, /es/blog/ y /blog/pagina/N/ si hay más de 9 artículos).
// Un único CTA (bloque de cierre). Indexación de la página 1: regla única blogIndexIndexable().
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCta from './blog-cta.astro';
import PostCard from './post-card.astro';
import { blogIndexSchema } from './schema';
import { CATEGORIES, FILTER_MIN_POSTS, POSTS_PER_PAGE, blogText, type CategoryKey } from '../../config/blog';
import { pages, type Locale } from '../../config/pages';
import { blogIndexIndexable, getPosts, pageCount, pagePath, postPath } from '../../lib/blog';
import logo from '../../assets/images/logo-web.webp';
import '../../styles/motion.css';
import { safeJsonLd } from '../../lib/json-ld';

interface Props {
  lang: Locale;
  page?: number;
}

const { lang, page = 1 } = Astro.props;
const t = blogText[lang];
const all = await getPosts(lang);
const total = pageCount(all.length);
const posts = all.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE);
// Página 1: index solo con artículos publicados. Las siguientes solo existen con artículos.
const indexable = page > 1 || (await blogIndexIndexable(lang));
const path = pagePath(lang, page);
const pageUrl = new URL(path, Astro.site).href;
const title = page > 1 ? `${t.metaTitle.replace(' | ', ` · ${t.pageLabel.replace('{n}', String(page))} | `)}` : t.metaTitle;
const description = page > 1 ? `${t.metaDescription.replace(/\.$/, '')} (${t.pageLabel.replace('{n}', String(page))}).` : t.metaDescription;
// Paginación: cada idioma tiene sus propias páginas; hreflang solo si existe la misma página en el otro idioma.
const other: Locale = lang === 'ca' ? 'es' : 'ca';
const otherTotal = pageCount((await getPosts(other)).length);
const alternates = page > 1 ? { [lang]: path, ...(page <= otherTotal ? { [other]: pagePath(other, page) } : {}) } : undefined;
const categories = [...new Set(posts.map((p) => p.data.category))] as CategoryKey[];
const showFilter = posts.length >= FILTER_MIN_POSTS && categories.length > 1;
const rss = `${pages.blog[lang]}rss.xml`;

const schema = blogIndexSchema({
  lang,
  pageUrl,
  homeUrl: new URL(pages.home[lang], Astro.site).href,
  name: t.title,
  description,
  homeName: t.home,
  logoUrl: new URL(logo.src, Astro.site).href,
  posts: posts.map((p) => ({ url: new URL(postPath(p), Astro.site).href, name: p.data.title })),
});
---

<BaseLayout
  lang={lang}
  pageKey={page > 1 ? undefined : 'blog'}
  alternates={alternates}
  switcherFallback="blog"
  title={title}
  description={description}
  noindex={!indexable}
  noindexFollow
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title={t.rssTitle} href={rss} />
    <Fragment set:html={`<script type="application/ld+json">${safeJsonLd(schema)}</script>`} />
  </Fragment>

  <div class="blog" data-section="blog">
    <header class="blog-head surface-grid surface-glow">
      <div class="container">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{t.title}</h1>
        <p class="blog-head__lead">{t.lead}</p>
      </div>
    </header>

    <section class="container blog-list" aria-label={t.eyebrow}>
      {
        posts.length > 0 ? (
          <>
            {showFilter && (
              <div class="blog-filter" data-blog-filter>
                <p class="blog-filter__label" id="blog-filter-label">
                  {t.filterLabel}
                </p>
                <div class="blog-filter__chips" role="group" aria-labelledby="blog-filter-label">
                  <button class="blog-chip" type="button" data-filter="all" aria-pressed="true">
                    {t.filterAll}
                  </button>
                  {categories.map((key) => (
                    <button class="blog-chip" type="button" data-filter={key} aria-pressed="false">
                      {CATEGORIES[key][lang]}
                    </button>
                  ))}
                </div>
                <p class="sr-only" aria-live="polite" data-filter-live />
              </div>
            )}
            <div class="blog-grid" data-blog-grid>
              {posts.map((post, i) => (
                <PostCard post={post} lang={lang} position={(page - 1) * POSTS_PER_PAGE + i + 1} priority={page === 1 && i === 0} />
              ))}
            </div>
            {total > 1 && (
              <nav class="blog-pages" aria-label={t.pagination}>
                {page > 1 && (
                  <a class="btn btn-ghost" href={pagePath(lang, page - 1)} rel="prev">
                    {t.prev}
                  </a>
                )}
                <span class="blog-pages__current">{t.pageLabel.replace('{n}', String(page))} / {total}</span>
                {page < total && (
                  <a class="btn btn-ghost" href={pagePath(lang, page + 1)} rel="next">
                    {t.next}
                  </a>
                )}
              </nav>
            )}
          </>
        ) : (
          <div class="blog-empty card" data-blog-empty>
            <span class="blog-empty__icon" aria-hidden="true">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h12l4 4v12H4Z" />
                <path d="M8 10h8M8 14h8M8 18h5" />
                <path class="blog-empty__bolt" d="M15 1.5 12.5 6h2l-1 3.5" />
              </svg>
            </span>
            <h2 class="blog-empty__title">{t.emptyTitle}</h2>
            <p class="blog-empty__text">{t.emptyText}</p>
            <BlogCta lang={lang} variant="index" bare />
          </div>
        )
      }
    </section>

    {
      posts.length > 0 && (
        <section class="container blog-close">
          <BlogCta lang={lang} variant="index" />
        </section>
      )
    }
  </div>
</BaseLayout>

<script>
  import '../../scripts/blog';
</script>

<style>
  .blog-head {
    padding-block: 1.75rem 2rem;
    border-bottom: 1px solid var(--teal-100);
  }

  .blog-head h1 {
    max-width: 24ch;
    margin-bottom: 0.75rem;
    font-size: clamp(1.75rem, 4vw + 0.75rem, 3rem);
  }

  .blog-head__lead {
    max-width: 40rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 1.125rem;
  }

  .blog-list {
    padding-block: 2rem 3rem;
  }

  /* Rejilla: 1 / 2 / 3 columnas con ancho máximo de tarjeta; con 1 o 2 artículos no se estiran. */
  .blog-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  @media (min-width: 40rem) {
    .blog-grid {
      grid-template-columns: repeat(2, minmax(0, 22rem));
    }
  }

  @media (min-width: 64rem) {
    .blog-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }

  }

  /* ---- Filtro ---- */
  .blog-filter {
    margin-bottom: 1.5rem;
  }

  /* Sin JS el filtro no haría nada: se oculta. Con JS se ve desde el primer pintado (sin CLS). */
  html:not(.js) .blog-filter {
    display: none;
  }

  .blog-filter__label {
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .blog-filter__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .blog-chip {
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 1.5px solid var(--teal-100);
    border-radius: 999px;
    background: var(--white);
    color: var(--teal-900);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 0.15s,
      border-color 0.15s;
  }

  .blog-chip[aria-pressed='true'] {
    border-color: var(--teal-900);
    background: var(--teal-900);
    color: var(--white);
  }

  @media (hover: hover) {
    .blog-chip:hover {
      border-color: var(--teal-900);
    }
  }

  /* ---- Paginación ---- */
  .blog-pages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
    margin-top: 2rem;
  }

  .blog-pages .btn {
    color: var(--teal-900);
  }

  .blog-pages__current {
    color: var(--text-muted);
    font-weight: 700;
  }

  /* ---- Estado vacío ---- */
  .blog-empty {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
    max-width: 44rem;
    padding: 2rem 1.5rem;
    border-radius: 1.5rem;
  }

  .blog-empty__icon {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 1.25rem;
    background: var(--teal-900);
    color: var(--orange-500);
  }

  .blog-empty__bolt {
    animation: blog-blink 2.4s ease-in-out infinite;
  }

  @keyframes blog-blink {
    50% {
      opacity: 0.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-empty__bolt {
      animation: none;
    }
  }

  .blog-empty__title {
    margin: 0.5rem 0 0;
  }

  .blog-empty__text {
    margin: 0 0 0.75rem;
    color: var(--text-muted);
    font-size: 1.125rem;
  }

  /* ---- Cierre ---- */
  .blog-close {
    padding-bottom: 3rem;
  }

  @media (min-width: 48rem) {
    .blog-head {
      padding-block: 3rem 3rem;
    }

    .blog-list {
      padding-block: 3rem 4rem;
    }

    .blog-empty {
      padding: 3rem;
    }

    .blog-close {
      padding-bottom: 5rem;
    }
  }
</style>
