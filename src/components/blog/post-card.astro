---
// Tarjeta de artículo (índice y "Segueix llegint"). Un solo enlace, el del título,
// estirado a toda la tarjeta con ::after (patrón "stretched link"). Foco con :focus-within.
import { Image } from 'astro:assets';
import BrandCover from './brand-cover.astro';
import { CATEGORIES, blogText } from '../../config/blog';
import type { Locale } from '../../config/pages';
import { formatDate, isoDate, postPath, postSlug, readingMinutes, type Post } from '../../lib/blog';

interface Props {
  post: Post;
  lang: Locale;
  /** Posición en la lista (1, 2, 3…): evento blog_card_click y retardo del revelado. */
  position: number;
  heading?: 'h2' | 'h3';
  /** Primera tarjeta sobre el pliegue: imagen con prioridad. */
  priority?: boolean;
}

const { post, lang, position, heading = 'h2', priority = false } = Astro.props;
const t = blogText[lang];
const Heading = heading;
const { title, description, cover, coverAlt, coverPosition, pubDate, category } = post.data;
---

<article class="post-card card-lift" data-reveal data-category={category} style={`--i:${(position - 1) % 3}`}>
  <div class="post-card__media">
    {
      cover ? (
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[480, 768, 1200]}
          sizes="(min-width: 64rem) 352px, (min-width: 40rem) 50vw, 100vw"
          format="webp"
          quality={78}
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={priority ? 'high' : undefined}
          class="post-card__img"
          style={coverPosition ? `object-position: ${coverPosition}` : undefined}
        />
      ) : (
        <BrandCover category={category} />
      )
    }
  </div>
  <div class="post-card__body">
    <p class="post-card__cat">
      {CATEGORIES[category][lang]}
    </p>
    <Heading class="post-card__title">
      <a href={postPath(post)} data-card-link data-slug={postSlug(post)} data-position={position} data-lang={lang}>{title}</a>
    </Heading>
    <p class="post-card__excerpt">{description}</p>
    <p class="post-card__meta">
      <time datetime={isoDate(pubDate)}>{formatDate(pubDate, lang)}</time>
      <span aria-hidden="true">·</span>
      <span>{t.readingTime.replace('{n}', String(readingMinutes(post)))}</span>
    </p>
    <!-- Visual: el enlace real es el del título (toda la tarjeta es clicable). -->
    <span class="post-card__more" aria-hidden="true">{t.readMore} <span class="post-card__arrow">→</span></span>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--teal-100);
    border-radius: 1.25rem;
    background: var(--white);
  }

  .post-card[hidden] {
    display: none;
  }

  .post-card:focus-within {
    border-color: var(--orange-700);
    outline: 2px solid var(--orange-700);
    outline-offset: 3px;
  }

  /* Portada arriba, a todo el ancho: 16/10 en móvil, 16/9 desde tablet. Esquinas superiores
     redondeadas por el overflow: hidden de la tarjeta. */
  .post-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--teal-100);
  }

  .post-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  @media (min-width: 40rem) {
    .post-card__media {
      aspect-ratio: 16 / 9;
    }
  }

  .post-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.25rem 1.375rem;
  }

  .post-card__cat {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    width: fit-content;
    margin: 0;
    padding: 0.125rem 0.75rem;
    border-radius: 999px;
    background: var(--orange-100);
    color: var(--teal-900);
    font-weight: 700;
  }

  .post-card__title {
    margin: 0.25rem 0 0;
    font-size: clamp(1.1875rem, 1vw + 1rem, 1.375rem);
    line-height: 1.25;
  }

  .post-card__title a {
    color: var(--teal-900);
    text-decoration: none;
  }

  /* Stretched link: toda la tarjeta es el objetivo táctil del enlace del título. */
  .post-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  /* El foco se dibuja en la tarjeta (:focus-within), no en el título. */
  .post-card__title a:focus-visible {
    outline: none;
  }

  .post-card__excerpt {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--text-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.375rem;
    margin: auto 0 0;
    padding-top: 0.5rem;
    color: var(--text-muted);
  }

  .post-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 44px;
    color: var(--orange-700);
    font-weight: 700;
  }

  .post-card__arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .post-card:is(:hover, :focus-within, :active) .post-card__arrow {
    transform: translateX(4px);
  }

  .post-card:is(:hover, :focus-within) .post-card__title a {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  /* Zoom suave solo con puntero (nunca en táctil). */
  @media (hover: hover) and (pointer: fine) {
    .post-card:hover .post-card__media :global(img) {
      transform: scale(1.03);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card__media :global(img),
    .post-card__arrow {
      transition: none;
      transform: none !important;
    }
  }
</style>
