---
// Plantilla de las páginas legales (avís legal, privacitat y cookies), en los dos idiomas.
// Migas, H1, fecha de revisión, ficha del titular (opcional) y el texto de cada página en el slot.
// Sin CTA, sin FAQ y sin bloques comerciales. JSON-LD: solo WebPage y BreadcrumbList.
// Los datos salen de src/config/legal.ts; lo no confirmado lleva [[PENDIENTE: ...]]: con alguno,
// el build de producción falla (check-text) y el de staging avisa.
import BaseLayout from '../layouts/BaseLayout.astro';
import { pages, type Locale, type PageKey } from '../config/pages';
import { legal, legalUpdated } from '../config/legal';
import { absoluteUrl } from '../i18n/utils';
import { safeJsonLd } from '../lib/json-ld';

interface Props {
  lang: Locale;
  pageKey: Extract<PageKey, 'avisLegal' | 'privacitat' | 'cookies'>;
  title: string;
  description: string;
  heading: string;
  /** Título de la ficha del titular; sin él no se muestra la ficha. */
  ownerTitle?: string;
  /** Incluir los datos del Registro Mercantil en la ficha (avís legal). */
  registry?: boolean;
}

const { lang, pageKey, title, description, heading, ownerTitle, registry = false } = Astro.props;
const pageUrl = absoluteUrl(pages[pageKey][lang], Astro.site);
const homeUrl = absoluteUrl(pages.home[lang], Astro.site);
const root = new URL('/', pageUrl).href;

const l =
  lang === 'ca'
    ? {
        crumbs: 'Ruta de navegació',
        updated: 'Última revisió:',
        name: 'Titular',
        trade: 'Nom comercial',
        cif: 'CIF',
        address: 'Domicili social',
        email: 'Correu electrònic',
        phone: 'Telèfon',
        registry: 'Registre Mercantil',
      }
    : {
        crumbs: 'Ruta de navegación',
        updated: 'Última revisión:',
        name: 'Titular',
        trade: 'Nombre comercial',
        cif: 'CIF',
        address: 'Domicilio social',
        email: 'Correo electrónico',
        phone: 'Teléfono',
        registry: 'Registro Mercantil',
      };

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#pagina`,
      url: pageUrl,
      name: title,
      description,
      inLanguage: lang,
      isPartOf: { '@id': `${root}#web` },
      dateModified: legalUpdated.iso,
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: pages.home.name[lang], item: homeUrl },
        { '@type': 'ListItem', position: 2, name: pages[pageKey].name[lang], item: pageUrl },
      ],
    },
  ],
});
---

<BaseLayout lang={lang} pageKey={pageKey} title={title} description={description}>
  <Fragment slot="head">
    <Fragment set:html={`<script type="application/ld+json">${safeJsonLd(schema)}</script>`} />
  </Fragment>

  <article class="container legal" data-section="legal">
    <nav class="legal__crumbs" aria-label={l.crumbs}>
      <ol>
        <li><a href={pages.home[lang]}>{pages.home.name[lang]}</a></li>
        <li><span aria-current="page">{pages[pageKey].name[lang]}</span></li>
      </ol>
    </nav>

    <h1>{heading}</h1>
    <p class="legal__updated">{l.updated} <time datetime={legalUpdated.iso}>{legalUpdated[lang]}</time></p>

    {
      ownerTitle && (
        <section aria-labelledby="titular">
          <h2 id="titular">{ownerTitle}</h2>
          <dl class:list={['legal__data', { 'legal__data--spaced': registry }]}>
            <div><dt>{l.name}</dt><dd>{legal.holder}</dd></div>
            <div><dt>{l.trade}</dt><dd>{legal.tradeName}</dd></div>
            <div><dt>{l.cif}</dt><dd>{legal.cif}</dd></div>
            <div><dt>{l.address}</dt><dd>{legal.address}</dd></div>
            <div><dt>{l.email}</dt><dd><a href={`mailto:${legal.email}`}>{legal.email}</a></dd></div>
            <div><dt>{l.phone}</dt><dd>{legal.phone}</dd></div>
            {registry && <div><dt>{l.registry}</dt><dd>{legal.registry[lang]}</dd></div>}
          </dl>
        </section>
      )
    }

    <slot />
  </article>
</BaseLayout>

<style is:global>
  /* Global pero acotado a .legal: el texto de cada página llega por el slot. */
  .legal {
    max-width: 48rem;
    padding-block: 1.5rem 4rem;
  }

  .legal h2 {
    margin-top: 2.25rem;
    font-size: 1.375rem;
  }

  .legal h3 {
    margin-top: 1.5rem;
    font-size: 1.125rem;
  }

  .legal ul {
    padding-left: 1.25rem;
  }

  .legal li + li {
    margin-top: 0.375rem;
  }

  .legal__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0 0 0.5rem;
    padding: 0;
    list-style: none;
    color: var(--text-muted);
  }

  .legal__crumbs li + li {
    margin-top: 0;
  }

  .legal__crumbs li + li::before {
    content: '›';
    margin-inline: 0.5rem;
  }

  .legal__crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--teal-900);
    font-weight: 600;
  }

  .legal__updated {
    color: var(--text-muted);
  }

  .legal__data {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  /* Avís legal: separa la ficha del párrafo que la sigue (misma distancia que entre apartados). */
  .legal__data--spaced {
    margin-bottom: 2.25rem;
  }

  .legal__data div {
    display: grid;
    gap: 0.125rem;
  }

  .legal__data dt {
    color: var(--text-muted);
    font-weight: 700;
  }

  .legal__data dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .legal__note {
    padding: 1rem;
    background: var(--orange-100);
    border-radius: 0.75rem;
  }

  /* Tabla de cookies: tarjetas en móvil (sin scroll horizontal), tabla desde 48rem. */
  .legal-table {
    width: 100%;
    margin-block: 1rem;
    border-collapse: collapse;
  }

  .legal-table caption {
    margin-bottom: 0.5rem;
    font-weight: 700;
    text-align: left;
  }

  .legal-table thead {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .legal-table tr {
    display: block;
    margin-bottom: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--white);
    border: 1px solid var(--teal-100);
    border-radius: 0.75rem;
  }

  .legal-table td {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.75rem;
    padding-block: 0.25rem;
    overflow-wrap: anywhere;
  }

  .legal-table td::before {
    content: attr(data-label);
    color: var(--text-muted);
    font-weight: 700;
  }

  .legal-table code {
    overflow-wrap: anywhere;
  }

  @media (min-width: 40rem) {
    .legal__data div {
      grid-template-columns: 12rem 1fr;
      gap: 1rem;
    }
  }

  @media (min-width: 48rem) {
    .legal-table thead {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      white-space: normal;
    }

    .legal-table tr {
      display: table-row;
      margin: 0;
      padding: 0;
      border: 0;
      border-radius: 0;
    }

    .legal-table th,
    .legal-table td {
      display: table-cell;
      padding: 0.625rem 0.75rem;
      text-align: left;
      vertical-align: top;
      border-bottom: 1px solid var(--teal-100);
    }

    .legal-table th {
      background: var(--teal-100);
    }

    .legal-table td::before {
      content: none;
    }
  }
</style>
