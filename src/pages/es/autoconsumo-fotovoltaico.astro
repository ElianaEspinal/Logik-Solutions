const pageUrl = new URL(pages.autoconsum.es, Astro.site).href;
const logoUrl = new URL(logo.src, Astro.site).href;
const schema = solarSchema({
  lang: 'es',
  pageUrl,
  homeUrl: new URL(pages.home.es, Astro.site).href,
  title,
  description,
  homeName: content.breadcrumbHome,
  pageName: pages.autoconsum.name.es,
  serviceType: content.serviceType,
  audience: content.audience,
  faq: content.faq.items,
});
---

<BaseLayout lang="es" pageKey="autoconsum" title={title} description={description} og={{ image: logoUrl, imageAlt: 'Logik Solutions' }}>
  <Fragment slot="head" set:html={`<script type="application/ld+json">${safeJsonLd(schema)}</script>`} />
  <SolarPage lang="es" content={content} />
</BaseLayout>
