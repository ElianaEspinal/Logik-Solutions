---
// Autoconsumo fotovoltaico (castellano). Textos de Eliana (encargo del 4/11/2026), con apóstrofo recto.
// Los marcados [Claude] no estaban en el encargo.
// En esta página nunca "sin coste" ni "gratis": la instalación tiene un coste.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SolarPage from '../../components/solar/solar-page.astro';
import { solarSchema } from '../../components/solar/schema';
import type { SolarContent } from '../../components/solar/types';
import { pages } from '../../config/pages';
import logo from '../../assets/images/logo-web.webp';
import { safeJsonLd } from '../../lib/json-ld';

const title = 'Placas solares en Girona y autoconsumo | Logik Solutions';
