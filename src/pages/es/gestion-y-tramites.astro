const pageUrl = new URL(pages.gestio.es, Astro.site).href;
const logoUrl = new URL(logo.src, Astro.site).href;
const schema = gestionsSchema({
  lang: 'es',
  pageUrl,
  homeUrl: new URL(pages.home.es, Astro.site).href,
  title,
  description,
  homeName: content.breadcrumbHome,
  pageName: pages.gestio.name.es,
  serviceType: content.serviceType,
  audience: content.serviceAudience,
  faq: content.faq.items,
});
---

<BaseLayout lang="es" pageKey="gestio" title={title} description={description} og={{ image: logoUrl, imageAlt: 'Logik Solutions' }}>
  <Fragment slot="head" set:html={`<script type="application/ld+json">${safeJsonLd(schema)}</script>`} />
  <GestionsPage lang="es" content={content} />
</BaseLayout>
