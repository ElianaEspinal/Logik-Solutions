---
// Empresas y pymes (castellano). Textos de Eliana (encargo del 3/11/2026), con apóstrofo recto.
// Los marcados [Claude] no estaban en el encargo.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BusinessPage from '../../components/business/business-page.astro';
import { businessSchema } from '../../components/business/schema';
import type { BusinessContent } from '../../components/business/types';
import { pages } from '../../config/pages';
import logo from '../../assets/images/logo-web.webp';
import { safeJsonLd } from '../../lib/json-ld';

const title = 'Consultoría energética para pymes | Logik Solutions';
const description =
  'Consultoría energética para pymes y empresas en Girona y toda España: revisamos tu factura, comparamos ofertas y te hacemos el seguimiento todo el año.';

const content: BusinessContent = {
  hero: {
