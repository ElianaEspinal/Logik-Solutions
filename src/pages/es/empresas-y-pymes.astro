    { value: '+2.000', label: 'clientes' },
    { value: '+10', label: 'años en el sector' },
    { value: '12 meses', label: 'de seguimiento' },
  ],
  sectors: {
    eyebrow: 'Para quién',
    title: 'Pensado para negocios como el tuyo',
