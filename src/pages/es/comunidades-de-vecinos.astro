    cta: 'Revisa la factura de mi comunidad →',
  },
  services: {
    title: 'Ahorro energético en comunidades de vecinos: qué incluye el servicio',
    items: [
      {
        title: 'Revisión y comparativa',
        text: 'Revisamos el suministro de la comunidad y comparamos ofertas de varias comercializadoras.',
      },
      {
        title: 'Trámites con la compañía',
        text: 'Cambios de titularidad, subidas y bajadas de potencia y altas nuevas, con trato directo con los administradores de cada compañía.',
        link: 'Gestión y trámites →',
        page: 'gestio',
      },
      {
        title: 'Seguimiento mensual y anual',
        text: 'Revisamos la factura de la comunidad durante todo el año.',
      },
      {
        title: 'Renovación e incidencias',
        text: 'Te avisamos en el mes 11 para renovar y resolvemos las incidencias, incluidas en el servicio.',
