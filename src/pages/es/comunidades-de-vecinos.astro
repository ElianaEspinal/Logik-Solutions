---
// Comunidades de vecinos (castellano). Textos de Eliana (encargo del 4/11/2026), escritos aparte
// del catalán. Los marcados [Claude] no estaban en el encargo.
// Interruptor COMUNITATS_FV (src/config/comunitats.ts): con false (hoy) no se usa "placas solares"
// en title, H1, meta ni JSON-LD, y no se pintan el bloque solar ni su pregunta del FAQ.
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunitiesPage from '../../components/communities/communities-page.astro';
import { communitiesSchema } from '../../components/communities/schema';
import type { CommunitiesContent } from '../../components/communities/types';
import { COMUNITATS_FV } from '../../config/comunitats';
import { pages } from '../../config/pages';
import logo from '../../assets/images/logo-web.webp';
import { safeJsonLd } from '../../lib/json-ld';

const title = COMUNITATS_FV
  ? 'Placas solares para comunidades de vecinos | Logik Solutions'
  : 'Consultoría energética para comunidades | Logik Solutions';
const description = COMUNITATS_FV
  ? 'Placas solares y consultoría energética para comunidades de vecinos en Girona. Un solo interlocutor para el administrador y los vecinos.'
  : 'Consultoría energética para comunidades de vecinos en Girona: un solo interlocutor para el administrador y los vecinos, y seguimiento todo el año.';

const faqBase = [
  {
    q: '¿Trabajáis con el administrador de fincas o con los vecinos?',
    a: 'Con ambos. Somos un solo interlocutor para el administrador y para los vecinos.',
  },
  {
    q: '¿La factura de la comunidad es diferente de la de mi casa?',
    a: 'Sí: la factura de las zonas comunes es independiente de la de cada vivienda y la paga la comunidad. Con una factura reciente vemos qué hay en cada concepto.',
  },
  {
    q: '¿Hay que cambiar la tarifa de luz de la comunidad?',
    a: 'No necesariamente. Primero revisamos el contrato y te decimos qué tiene sentido en tu caso.',
  },
  {
    q: '¿Tiene coste para la comunidad?',
    a: 'El servicio de consultoría y gestiones no tiene coste: nos remunera la comercializadora con la que se contrata.',
  },
  {
    q: '¿Dónde trabajáis?',
    a: 'Nuestra base está en Girona y hacemos visitas presenciales en localidades cercanas. También trabajamos en toda Cataluña y en toda España.',
  },
];
const faqSolar = {
  q: '¿Hacéis instalaciones de placas solares para comunidades?',
  a: 'Sí, con ingenieros y especialistas en instalación. La instalación tiene un coste; antes te explicamos si tiene sentido para vuestro consumo.',
};

const content: CommunitiesContent = {
  hero: {
    tag: 'Comunidades de vecinos',
