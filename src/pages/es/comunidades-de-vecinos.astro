    nodes: { admin: 'Administrador', residents: 'Vecinos', logik: 'Logik Solutions', companies: 'Compañías' },
    chips: ['Suministros de las zonas comunes', 'Coordinación con el administrador', 'Seguimiento mensual y anual'],
  },
  bill: {
    eyebrow: 'Entiende la factura',
    title: 'La factura de la luz de una comunidad de vecinos, explicada',
    items: [
      {
        icon: 'building',
        title: 'Es la factura de la comunidad',
        text: 'El suministro de las zonas comunes es independiente de la luz de cada vivienda: el contrato es de la comunidad y lo pagan todos los vecinos a través de las cuotas.',
      },
      {
        icon: 'lift',
        title: 'Dónde se consume',
        text: 'Ascensores, alumbrado y otros equipos de las zonas comunes. Con una factura reciente vemos qué hay en cada concepto.',
      },
      {
        icon: 'search',
        title: 'Qué revisamos',
        text: 'La potencia contratada, las franjas horarias de consumo y el vencimiento del contrato. Por eso te avisamos en el mes 11.',
