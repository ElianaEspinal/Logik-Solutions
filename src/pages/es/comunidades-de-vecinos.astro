    call: 'Llama al',
  },
  study: {
    title: 'Empieza el pre-estudio de tu comunidad',
    lead: 'Nos cuentas el caso en unos pocos pasos. Sin coste para ti: nos remunera la comercializadora.',
    callLead: '¿Prefieres llamar?',
    other: '¿No eres una comunidad?',
  },
  serviceType: 'Consultoría energética para comunidades de vecinos',
  audience: { communities: 'Comunidades de vecinos', administrators: 'Administradores de fincas' },
  breadcrumbHome: 'Inicio',
};

const pageUrl = new URL(pages.comunitats.es, Astro.site).href;
const logoUrl = new URL(logo.src, Astro.site).href;
const schema = communitiesSchema({
  lang: 'es',
  pageUrl,
  homeUrl: new URL(pages.home.es, Astro.site).href,
  title,
  description,
  homeName: content.breadcrumbHome,
  pageName: pages.comunitats.name.es,
  serviceType: content.serviceType,
  audience: content.audience,
  faq: content.faq.items,
});
---

<BaseLayout lang="es" pageKey="comunitats" title={title} description={description} og={{ image: logoUrl, imageAlt: 'Logik Solutions' }}>
  <Fragment slot="head" set:html={`<script type="application/ld+json">${safeJsonLd(schema)}</script>`} />
  <CommunitiesPage lang="es" content={content} />
</BaseLayout>
