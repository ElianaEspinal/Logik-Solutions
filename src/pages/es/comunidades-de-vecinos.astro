  blogTitle: 'Para profundizar',
  solar: {
    title: '¿Y si la comunidad quiere placas solares?',
    text: 'Primero estudiamos el consumo de las zonas comunes. Si el autoconsumo tiene sentido, la instalación la hacen ingenieros y especialistas. La instalación tiene un coste; antes te explicamos si tiene sentido para vuestro consumo.',
    link: 'Autoconsumo fotovoltaico →',
  },
  faq: {
    eyebrow: '¿Dudas?',
    title: 'Preguntas frecuentes sobre consultoría energética para comunidades de vecinos',
    items: COMUNITATS_FV ? [...faqBase, faqSolar] : faqBase,
  },
  admin: {
    id: 'administradores-de-fincas', // [Claude]: destino del chip "Soy administrador de fincas"
    title: '¿Eres administrador de fincas?',
    text: 'Si administras varias comunidades, habla con nosotros y lo miramos.',
