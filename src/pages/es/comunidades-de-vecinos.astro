    { value: '+2.000', label: 'clientes' },
    { value: '+10', label: 'años en el sector' },
    { value: '12 meses', label: 'de seguimiento' },
  ],
  persona: {
    eyebrow: 'Para quién',
    title: 'Pensado para comunidades y administradores de fincas',
    text: 'Logik Solutions es una consultoría energética de Girona. Las comunidades de vecinos son una de las áreas en las que trabajamos, junto con las empresas y pymes y los hogares.',
    label: 'Elige tu caso', // [Claude]: nombre accesible de la lista de chips
    admin: 'Soy administrador de fincas',
    resident: 'Soy presidente o vecino',
    hint: 'Elige tu caso y empieza.',
  },
  hub: {
    eyebrow: 'Cómo te lo ponemos fácil',
