# Entorno: production (por defecto) | staging. La indexación depende de esto (docs/despliegue.md).
# Los scripts npm run build y npm run build:staging ya lo fijan; aquí solo para npm run dev.
SITE_ENV=production
# Dominio del entorno, https y sin barra final. Vacío = https://logiksolutions.es (producción).
# En staging pon el subdominio de pruebas, p. ej. SITE_URL=https://<subdominio-de-pruebas>
SITE_URL=
# Destino del formulario: URL completa (p. ej. https://formspree.io/f/XXXXXXXX). Vacío = no envía.
PUBLIC_FORM_ENDPOINT=
# Adjuntar factura: true solo si el servicio del formulario admite archivos.
PUBLIC_FORM_ATTACHMENTS=false
# Google Tag Manager (GA4 se configura dentro de GTM). Vacío = no se carga.
PUBLIC_GTM_ID=GTM-5LSF5885
# Déjalo en false. Para la vista previa de GTM en staging usa `npm run build:staging:gtm`.
PUBLIC_GTM_TEST=false
